---
import About from './pages/About.astro';
import Work from './pages/Work.astro';
import Blog from './pages/Blog.astro';
import Contact from './pages/Contact.astro';
import Devlog from './pages/Devlog.astro';
import VisitorLounge from './pages/VisitorLounge.astro';
import CharacterList from './pages/CharacterList.astro';
---

<div id="about-container" class="fade-section show">
  <About />
</div>

<div id="work-container" class="fade-section">
  <Work />
</div>

<div id="blog-container" class="fade-section">
  <Blog />
</div>

<div id="contact-container" class="fade-section">
  <Contact />
</div>

<div id="devlog-container" class="fade-section">
  <Devlog />
</div>

<div id="visitor-container" class="fade-section">
  <VisitorLounge />
</div>

<div id="oc-container" class="fade-section">
  <CharacterList />
</div>

<style>
.fade-section {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.4s ease, transform 0.4s ease;
  position: absolute;
  width: 100%;
  pointer-events: none;
  user-select: none;
}

.fade-section.show {
  opacity: 1;
  transform: translateY(0);
  z-index: 1;
  pointer-events: auto;
  user-select: auto;
}

.fade-section.hide {
  opacity: 0;
  transform: translateY(5px);
  z-index: 0;
  pointer-events: none;
  user-select: none;
}
</style>

<script type="module" client:load>
const sections = {
  about: document.getElementById('about-container'),
  work: document.getElementById('work-container'),
  blog: document.getElementById('blog-container'),
  contact: document.getElementById('contact-container'),
  devlog: document.getElementById('devlog-container'),
  visitor: document.getElementById('visitor-container'),
  oc: document.getElementById('oc-container')
};

/** * EDITABLE URL MAP
 * Change the text on the right to change what appears after the #
 */
const urlMap = {
  about: "about",
  work: "portfolio",      // Result: .../portfolio/#portfolio
  blog: "studystuffs",    // Result: .../portfolio/#studystuffs
  contact: "contact",
  devlog: "blogs",
  visitor: "lounge",
  oc: "characters"        // Result: .../portfolio/#characters
};

const navTabs = document.querySelectorAll('.sidebar .tab');

// Helper to find the internal container ID based on the URL fragment
function getInternalIdFromUrl(urlSlug) {
  return Object.keys(urlMap).find(key => urlMap[key] === urlSlug) || 'about';
}

function switchContent(target, updateHistory = true) {
  const prettyUrl = urlMap[target] || target;

  Object.keys(sections).forEach(key => {
    const section = sections[key];
    if (key === target) {
      section.classList.remove('hide');
      section.classList.add('show');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      
      // Update the URL hash
      if (updateHistory) {
        history.pushState(null, null, `#${prettyUrl}`);
      }
    } else {
      section.classList.remove('show');
      section.classList.add('hide');
    }
  });
}

// Sidebar tab click
navTabs.forEach(tab => {
  tab.addEventListener('click', e => {
    e.preventDefault();
    const target = tab.dataset.target;
    switchContent(target);
  });
});

// INITIAL LOAD: Handle Deep Linking
window.addEventListener('DOMContentLoaded', () => {
  const hash = window.location.hash.replace('#', '');
  if (hash) {
    const internalId = getInternalIdFromUrl(hash);
    switchContent(internalId, false); // Don't push state on first load
  } else {
    // Default to about if no hash is provided
    switchContent('about', false);
  }
});

// BROWSER NAVIGATION: Handle Back/Forward buttons
window.addEventListener('popstate', () => {
  const hash = window.location.hash.replace('#', '');
  const internalId = getInternalIdFromUrl(hash);
  switchContent(internalId, false); // Don't push a new state when navigating back
});

// Custom Event Listener
window.addEventListener('switchContent', e => {
  switchContent(e.detail.target);
});
</script>
---
import Container from "../Container.astro";
import LifeMap from "./blog_modules/LifeMap.astro";
import ToDos from "./blog_modules/ToDos.astro";
import ClassSchedule from "./blog_modules/ClassSchedule.astro";
---

<main class="content">
  <Container variant="static" class="flowchart-container">
  
    <!-- Title -->
    <div class="goal-title-line">
      <div class="goal-line"></div>
      <h1 id="goal-title">Study Zone</h1>
      <div class="goal-line"></div>
    </div>
  
    <!-- TAB BUTTONS -->
    <div class="growth-goal-tab">
      <button class="goal-btn active" data-goal="goal-life-map">Life Map</button>
      <button class="goal-btn" data-goal="goal-to-do">To-Do List</button>
      <button class="goal-btn" data-goal="goal-schedule">Class Schedule</button>
    </div>
  
    <!-- TAB CONTENT -->
    <div class="goal-content">
      <div id="goal-life-map" class="goal-panel active">
	  <div class="todo-header">
	    <h3>Life Map</h3>
		</div>
		<p class="goal-description">
		  This section shows how I plan to grow, the skills I’m building,
		  challenges I face, and goals I aim to reach. It tracks my progress year by year!! >:D<br>
		  Click on the nodes to trace their path and view their SMART overview!<br>
		</p>
        <LifeMap />
      </div>

      <div id="goal-to-do" class="goal-panel">
	    <div class="todo-header">
		  <h3>To-Do List</h3>
		  <button id="refreshTodo" class="refresh-btn">Refresh</button>
		</div>
	    <p class="goal-description">
		  This section shows a table of my ongoing tasks and deadlines!<br>
		</p>
        <ToDos />
      </div>
	  
	  <div id="goal-schedule" class="goal-panel">
	    <div class="todo-header">
		  <h3>Class Schedule</h3>
		</div>
	    <p class="goal-description">
		  This section shows my schedule! Keep this in mind if you want to contact / meet up with me! :]<br>
		</p>
        <ClassSchedule />
      </div>
    </div>
    
  </Container>
</main>

<script>
document.querySelectorAll(".goal-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    // Remove old actives
    document.querySelectorAll(".goal-btn").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".goal-panel").forEach(p => p.classList.remove("active"));

    // Set new active
    btn.classList.add("active");
    const panelId = btn.dataset.goal;
    document.getElementById(panelId).classList.add("active");
  });
});
</script>

<style>
/* ---------- Content & Card Styling ---------- */
main.content {
  flex: 1;
  margin-left: 260px;
  padding: 2rem;
  color: var(--text-dark);
}

/* ---------- Card ---------- */
.card {
  margin-top: 1.5rem;
  padding: 1.25rem;
  border-radius: 1rem;
  background: var(--color-6);
  border: 2px solid var(--color-5);
}

/* ---------- Headings ---------- */
h1 { font-size: 1.8rem; color: var(--color-1); margin-bottom: 1rem; }
h2 { font-size: 1.3rem; color: var(--color-2); margin-bottom: 0.5rem; margin-top: -0.5rem; }
h3 {
  font-size: 1.3rem;
  color: var(--color-2);
  font-weight: 600;
  line-height: 0; /* <— FIX: aligns it to center */
}


.todo-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 0rem;
  margin-bottom: -1rem;
}

.todo-header::after {
  content: "";
  flex-grow: 1;
  height: 2.5px;
  background-color: var(--color-5);
  opacity: 0.5;
}


.goal-description { color: var(--text-dark); }

/* ---------- Goal Title Line ---------- */
.goal-title-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
  gap: 1rem;
}
.goal-line {
  flex: 1;
  height: 2px;
  background-color: var(--color-6);
  opacity: 1;
  transform: scaleX(1);
}
#goal-title {
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  margin: 0;
  white-space: nowrap;
  display: flex;
  justify-content: center;
}

/* ---------- Tabs ---------- */
.growth-goal-tab {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1rem;
}
.goal-btn {
  padding: 0.5rem 1rem;
  border-radius: 0.75rem;
  border: 2px solid var(--color-1);
  background: var(--color-1);
  color: var(--text-dark);
  cursor: pointer;
  font-weight: 60;
  transition: all 0.2s ease;
}
.goal-btn.active {
  background: var(--color-6);
  color: var(--text-dark);
}

/* ---------- Panels ---------- */
.goal-content .goal-panel { display: none; }
.goal-content .goal-panel.active { display: block; }

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  main.content { margin-left: 0; padding: 0.5rem; flex: 1; }
  .card { padding: 0.5rem; margin-top: 0.5rem; }
  p, li, span, a { font-size: 0.55rem; margin: 0.5rem; }
  h2 { font-size: 0.9rem; margin: 0.3rem; }
  h3 { font-size: 0.8rem; }
  #goal-title { font-size: 1.5rem; text-align: center; white-space: normal; }
  .goal-title-line { gap: 0.5rem; }
  .goal-line { height: 1px; }
}

.refresh-btn {
  padding: 0.1rem 0.5rem;
  background-color: var(--color-1);
  color: var(--text-dark);
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 0.9rem;
  margin-bottom: 0rem;
  transition: 0.2s;
  border: 2px solid var(--color-1);
}

.refresh-btn:hover {
  background: var(--color-6);
  color: var(--text-dark);
}
</style>

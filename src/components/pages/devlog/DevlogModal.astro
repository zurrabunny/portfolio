<div id="devlog-modal" class="modal">
  <div class="modal-inner">

    <button class="modal-close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <h2 class="modal-title"></h2>

    <div class="goal-title-line">
      <div class="goal-line"></div>
      <small class="modal-date"></small>
      <div class="goal-line"></div>
    </div>

    <div class="modal-tags"></div>

    <div class="modal-content"></div>
	<div id="devlog-player-container"></div>
  </div>
</div>

<div id="devlog-player-container"></div>

<script client:load>
/* ---------- Inject styling for volume slider + player ---------- */
const style = document.createElement("style");
style.textContent = `
.custom-player {
  width: 96%;
  margin: 1rem 0;
  padding: 1rem;
  border-radius: 10px;
  background: var(--color-6);
  border: 2px solid var(--border-sidebar);
}

.custom-player strong {
  display: block;
  margin-bottom: 0.5rem;
  color: var(--color-2);
  font-size: 1.1rem;
}

.custom-player .controls {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  width: 100%;
}

.custom-player .play-btn {
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
}

/* Progress bar */
.custom-player .progress {
  flex: 1;
  height: 6px;
  border-radius: 4px;
  background: var(--border-sidebar);
  appearance: none;
  outline: none;
  cursor: pointer;
}

/* Webkit (Chrome/Safari) */
.custom-player .progress::-webkit-slider-runnable-track {
  height: 6px;
  border-radius: 4px;
  background: var(--border-sidebar);
}

.custom-player .progress::-webkit-slider-thumb {
  appearance: none;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
  margin-top: -3.5px;
}

/* Firefox */
.custom-player .progress::-moz-range-track {
  height: 6px;
  border-radius: 4px;
  background: var(--border-sidebar);
}

.custom-player .progress::-moz-range-thumb {
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: var(--color-2);
  cursor: pointer;
}

.custom-player .time {
  font-size: 0.85rem;
  color: var(--text-main);
  white-space: nowrap;
}

.volume-slider {
  width: 70px;
  height: 6px;
  appearance: none;
  background: var(--border-sidebar);
  border-radius: 4px;
  cursor: pointer;
  margin-left: auto;
}

.volume-slider::-webkit-slider-thumb {
  appearance: none;
  width: 12px;
  height: 12px;
  background: var(--color-2);
  border-radius: 50%;
}

.volume-slider::-moz-range-thumb {
  width: 12px;
  height: 12px;
  background: var(--color-2);
  border-radius: 50%;
}
`;
document.head.appendChild(style);

/* ---------- ELEMENTS ---------- */
const modal = document.getElementById('devlog-modal');
const modalInner = modal.querySelector('.modal-inner');
const titleEl = modal.querySelector('.modal-title');
const dateEl = modal.querySelector('.modal-date');
const contentEl = modal.querySelector('.modal-content');
const closeBtn = modal.querySelector('.modal-close');
const modalTags = modal.querySelector('.modal-tags');

let activeAudios = [];

/* ---------- WAIT FOR CARDS ---------- */
const waitForCards = setInterval(() => {
  const cards = document.querySelectorAll('.devlog-card');
  if (!cards.length) return;
  clearInterval(waitForCards);

  cards.forEach(card => {
    card.addEventListener('click', () => {

      // Pause any active audio
      activeAudios.forEach(a => a.pause());
      activeAudios = [];

      // Inject content
      titleEl.innerText = card.dataset.title;
      dateEl.innerText = new Date(card.dataset.date).toDateString();
      contentEl.innerHTML = card.dataset.body;

      const tags = (card.dataset.tags || "").split(",");
      modalTags.innerHTML = tags.map(tag => `<span class="modal-tag">#${tag}</span>`).join(' ');

      // Find all <devlog-music-player> tags
      const players = contentEl.querySelectorAll('devlog-music-player');

      players.forEach(playerTag => {
        const src = playerTag.getAttribute("data-src");
        const title = playerTag.getAttribute("data-title") || "Audio Track";

        // Create player
        const wrapper = document.createElement("div");
        wrapper.classList.add("custom-player");
        wrapper.innerHTML = `
          <strong>${title}</strong>
          <div class="controls">
            <button class="play-btn">
              <img class="play-icon" src="play.svg">
              <img class="pause-icon" src="pause.svg" style="display:none;">
            </button>
            <input type="range" class="progress" value="0" min="0" max="100">
            <span class="time">0:00 / 0:00</span>
            <input type="range" class="volume-slider" min="0" max="1" step="0.01" value="1">
          </div>
        `;

        // Replace original tag with player
        playerTag.replaceWith(wrapper);

        // Audio logic
        const audio = new Audio(src);
        activeAudios.push(audio);

        const playBtn = wrapper.querySelector('.play-btn');
        const playIcon = wrapper.querySelector('.play-icon');
        const pauseIcon = wrapper.querySelector('.pause-icon');
        const progress = wrapper.querySelector('.progress');
        const timeEl = wrapper.querySelector('.time');
        const volumeSlider = wrapper.querySelector('.volume-slider');

        let isPlaying = false;
        let dragging = false;

        // Play/pause
        playBtn.addEventListener("click", () => {
          activeAudios.forEach(a => a !== audio && a.pause());
          isPlaying ? audio.pause() : audio.play();
        });

        audio.addEventListener("play", () => {
          isPlaying = true;
          playIcon.style.display = "none";
          pauseIcon.style.display = "inline";
        });

        audio.addEventListener("pause", () => {
          isPlaying = false;
          playIcon.style.display = "inline";
          pauseIcon.style.display = "none";
        });

        // Time update
        audio.addEventListener("timeupdate", () => {
          if (!dragging) {
            let percent = (audio.currentTime / audio.duration) * 100 || 0;
            progress.value = percent;

            // Fill gradient
            progress.style.background = `linear-gradient(to right, var(--color-2) ${percent}%, var(--border-sidebar) ${percent}%)`;
          }
          timeEl.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
        });

        // Seek
        progress.addEventListener("mousedown", () => dragging = true);
        progress.addEventListener("mouseup", () => {
          dragging = false;
          audio.currentTime = (progress.value / 100) * audio.duration;
        });
        progress.addEventListener("input", () => {
          audio.currentTime = (progress.value / 100) * audio.duration;
        });

        // Volume
        volumeSlider.addEventListener("input", () => audio.volume = volumeSlider.value);

        function fmt(sec) {
          if (!sec || isNaN(sec)) return "0:00";
          const m = Math.floor(sec / 60);
          const s = Math.floor(sec % 60).toString().padStart(2, "0");
          return `${m}:${s}`;
        }
      });

      // Show modal
      modal.style.display = "flex";
      requestAnimationFrame(() => modal.classList.add("showing"));
      document.body.style.overflow = "hidden";
    });
  });

}, 100);

/* ---------- CLOSE MODAL ---------- */
function closeModal() {
  activeAudios.forEach(a => a.pause());
  activeAudios = [];

  modal.classList.remove("showing");
  modal.classList.add("hiding");

  setTimeout(() => {
    modal.style.display = "none";
    modal.classList.remove("hiding");
    document.body.style.overflow = "";
  }, 250);
}

closeBtn.addEventListener("click", closeModal);
modal.addEventListener("click", e => {
  if (!modalInner.contains(e.target)) closeModal();
});
</script>



<style>
.goal-title-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 1rem 0;
  gap: 0.75rem;
}

.goal-line {
  flex: 1;
  height: 2px;
  background-color: var(--color-4);
}

.modal {
  display: none;
  position: fixed;
  z-index: 9999;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(2px);
  justify-content: center;
  align-items: center;
  padding: 2rem;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.modal.showing { opacity: 1; }
.modal-inner {
  background: var(--color-6);
  border-radius: 12px;
  padding: 2rem;
  margin-top: -5rem;
  width: 100%;
  max-width: 1200px;
  max-height: 80vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 0 20px rgba(0,0,0,0.5);
  font-family: "Fredoka", sans-serif;
  color: var(--text-main);
  line-height: 1.6;
  border: 5px solid var(--border-sidebar);
  transform: scale(0.99);
  transition: transform 0.25s ease;
}

.modal.showing .modal-inner { transform: scale(1); }
.modal.hiding .modal-inner { transform: scale(0.99); }

.modal-close {
  position: absolute;
  top: 0.5rem;
  right: 1rem;
  font-size: 2rem;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--color-2);
}

.modal-title {
  font-size: 1.8rem;
  font-weight: 700;
  margin: 0 0 0.5rem 0;
  color: var(--color-2);
}

.modal-date {
  font-size: 0.85rem;
  color: var(--color-2);
  display: block;
  text-align: center;
  white-space: nowrap;
  margin: 0;
}

.modal-content h1, .modal-content h2, .modal-content h3 {
  color: var(--color-2);
  margin-top: 0;
  margin-bottom: 0.5rem;
}

.modal-content p { font-size: 1rem; margin-bottom: 0.8rem; }
.modal-content ul, .modal-content ol { margin-left: 1.5rem; margin-bottom: 1rem; }
.modal-content li { margin-bottom: 0.5rem; }
.modal-content a { color: var(--color-5); text-decoration: underline; }
.modal-content a:hover { color: var(--color-1); }

/* Audio styling */
.modal-content audio {
  width: 100%;
  margin: 1rem 0;
  outline: none;
}

@media (max-width: 900px) {
  .goal-title-line { gap: 0.5rem; }
  .goal-line { height: 1px; }
  .modal-inner { margin-right: 3rem; margin-left: -1rem; max-height: 80vh; }
}
</style>

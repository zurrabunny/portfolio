---
import { getCollection } from 'astro:content';
import DevlogCard from './DevlogCard.astro';

let entries = await getCollection('devlog');

// Sort pinned + date
entries = entries.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return new Date(b.data.date) - new Date(a.data.date);
});

// Collect all unique tags
const allTags = Array.from(
  new Set(
    entries
      .flatMap(e => e.data.tags || [])
      .map(t => t.trim())
  )
);
---
<div class="parent-container">
  <!-- Keyword search -->
  <input
    id="keyword-search"
    type="text"
    placeholder="Search blogs..."
  />

  <!-- Tag dropdown -->
  <div class="tag-dropdown">
    <button class="tag-toggle">
      <span class="label">Filter by Tag</span>
      <span class="arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </span>
    </button>

    <div class="tag-menu">
  <label class="tag-option">
    <input type="checkbox" value="all" checked />
    <span>All</span>
  </label>

  {allTags.map(tag => (
    <label class="tag-option">
      <input type="checkbox" value={tag} />
      <span>{tag}</span>
    </label>
  ))}
</div>

  </div>
</div>

<section class="devlog-list">
  {entries.map(entry => (
    <DevlogCard entry={entry} />
  ))}
</section>

<script client:load>
const toggle = document.querySelector(".tag-toggle");
const menu = document.querySelector(".tag-menu");
const checkboxes = document.querySelectorAll(".tag-option input");
const cards = document.querySelectorAll(".devlog-card");
const searchInput = document.getElementById("keyword-search");

let open = false;

// Toggle dropdown menu
toggle.addEventListener("click", () => {
  open = !open;
  menu.style.maxHeight = open ? menu.scrollHeight + "px" : "0px";
  menu.style.opacity = open ? "1" : "0";
  toggle.classList.toggle("open", open);
});

// Filter logic
function filterCards() {
  const input = searchInput.value.trim().toLowerCase();

  let exactPhrase = null;
  let keywords = [];

  const quoteMatch = input.match(/^"(.*)"$/);
  if (quoteMatch) {
    exactPhrase = quoteMatch[1];
  } else if (input.length > 0) {
    keywords = input.split(/\s+/);
  }

  // Collect selected tags
  const selectedTags = Array.from(checkboxes)
    .filter(cb => cb.checked && cb.value !== "all")
    .map(cb => cb.value);

  const useAll = selectedTags.length === 0 || document.querySelector('input[value="all"]').checked;

  cards.forEach(card => {
    const tags = card.dataset.tags.split(",");
    const title = card.dataset.title.toLowerCase();
    const desc = card.querySelector("p")?.textContent.toLowerCase() || "";
    const body = card.dataset.body.toLowerCase();

    const matchesTag = useAll || selectedTags.every(tag => tags.includes(tag));

    let matchesKeyword = true;

    if (exactPhrase) {
      matchesKeyword = title.includes(exactPhrase) ||
                       desc.includes(exactPhrase) ||
                       body.includes(exactPhrase);
    } else if (keywords.length > 0) {
      matchesKeyword = keywords.every(word =>
        title.includes(word) || desc.includes(word) || body.includes(word)
      );
    }

    card.style.display = matchesTag && matchesKeyword ? "" : "none";
  });
}

// Checkbox change events
checkboxes.forEach(cb => {
  cb.addEventListener("change", () => {
    // If 'all' is checked, uncheck others
    if (cb.value === "all" && cb.checked) {
      checkboxes.forEach(other => {
        if (other.value !== "all") other.checked = false;
      });
    } else if (cb.value !== "all" && cb.checked) {
      document.querySelector('input[value="all"]').checked = false;
    }
    filterCards();
  });
});

// Keyword input
searchInput.addEventListener("input", () => {
  filterCards();
});
</script>



<style is:global>
.parent-container {
  display: flex;
  gap: 0.5rem;
  align-items: center; /* vertically align search + button */
  margin-bottom: 1rem;
  position: relative; /* for dropdown layering if needed */
}

#keyword-search {
  flex: 1;
  min-width: 120px;
  padding: 0.45rem 0.7rem;
  border-radius: 0.45rem;
  border: 2px solid var(--color-5);
  background: var(--color-6);
  color: var(--text-main);
  font-family: "Fredoka", sans-serif;
  font-size: 0.75rem;
  height: 36px; /* match tag button height */
  box-sizing: border-box;
}

/* Tag dropdown wrapper */
.tag-dropdown {
  width: 160px;
  display: flex;
  flex-direction: column;
  position: relative; /* menu positioned relative to this */
  z-index: 1000;
}

/* Toggle button */
.tag-toggle {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-5);
  border: 2px solid var(--color-5);
  border-radius: 0.45rem;
  padding: 0.45rem 0.7rem;
  font-family: "Fredoka", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-3);
  cursor: pointer;
  transition: all 0.25s ease;
  height: 36px; /* same as search input */
  box-sizing: border-box;
}

.tag-toggle.open {
  background: var(--color-3);
  color: var(--text-main);
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.tag-toggle .arrow {
  display: flex;
  align-items: center;
  transition: transform 0.25s ease;
}

.tag-toggle .arrow svg {
  width: 16px;
  height: 16px;
}

.tag-toggle.open .arrow {
  transform: rotate(180deg);
}

/* Tag menu fixes */
.tag-menu {
  position: absolute;
  top: 100%; 
  left: 0;
  width: 97.8%; /* same as button */
  background: var(--color-6);
  border: 2px solid var(--color-5);
  border-top: none;
  border-radius: 0 0 0.45rem 0.45rem;
  max-height: 0;
  opacity: 0;
  overflow-y: auto; /* scroll if too many items */
  transition: max-height 0.35s ease, opacity 0.3s ease;
  z-index: 2000; 
  display: flex;
  flex-direction: column;
}

/* Tag options */
.tag-option {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-family: "Fredoka", sans-serif;
  font-size: 0.75rem;
  color: var(--text-main);
  cursor: pointer;
  white-space: nowrap; /* prevent wrapping */
  padding: 5px 10px;
  margin-bottom: 2px;
  margin-top: 2px;
  border-radius: 6px;
  user-select: none;
}

/* Hide default checkboxes */
.tag-option input[type="checkbox"] {
  display: none;
}

/* Tag option container */
.tag-option {
  display: flex;
  align-items: center;
  cursor: pointer;
  
}

/* Highlight on hover */
.tag-option:hover {
  color: var(--color-1);
}

/* Highlight when checked */
.tag-option input[type="checkbox"]:checked + span {
  color: var(--color-1);
}

/* Checkmark box on the left */
.tag-option span::before {
  content: "";
  display: inline-block;
  width: 18px;
  height: 18px;
  border: 2px solid var(--color-2);
  border-radius: 4px;
  margin-right: 8px;
  vertical-align: middle;
  background-color: var(--color-6);
  transition: all 0.2s;
}

/* Show checkmark when checked */
.tag-option input[type="checkbox"]:checked + span::before {
  content: "✔";
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: var(--color-2);
}

</style>

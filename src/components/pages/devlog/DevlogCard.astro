---
const { entry } = Astro.props;
const { title, date, description, pinned, tags } = entry.data;
---

<article class="devlog-card"
         data-title={title}
         data-date={date}
         data-body={entry.body ? entry.body : ''}
         data-tags={tags ? tags.join(',') : ''}
         data-pinned={pinned ? 'true' : 'false'}>

  {pinned && <span class="pinned-badge">Pinned</span>}

  <h2>{title}</h2>
  <p>{description}</p>

  <div class="card-footer">
    <small class="card-date">{date}</small>
    {tags && tags.length > 0 && (
      <span class="card-tags">
        {tags.map(tag => (
          <span class="modal-tag">#{tag}</span>
        ))}
      </span>
    )}
  </div>
</article>

<style>
.devlog-card {
  padding: 0.6rem 0.8rem;
  border: 2px solid var(--border-sidebar);
  border-radius: 8px;
  margin-bottom: 0.6rem;
  cursor: pointer;
  transition: background 0.2s ease;
  font-size: 0.85rem;
  position: relative; /* for badge positioning if needed */
}

.pinned-badge {
  position: absolute;
  top: 6px;
  right: 6px;
  background: var(--color-2);
  padding: 2px 6px;
  color: white;
  border-radius: 4px;
  font-size: 0.65rem;
}

.devlog-card h2 {
  font-size: 1rem;
  margin: 0 0 0.3rem 0;
  color: var(--color-2);
}

.devlog-card p {
  font-size: 0.75rem;
  margin: 0 0 0.3rem 0;
  line-height: 1.2;
  color: var(--text-dark);
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.card-date {
  font-size: 0.65rem;
  color: var(--color-2);
}

.card-tags {
  display: flex;
  gap: 0.3rem;
  flex-wrap: wrap;
}

.modal-tag {
  background-color: var(--color-5);
  color: var(--text-main);
  font-size: 0.55rem; /* same as date */
  font-weight: 10;
  padding: 0.15rem 0.4rem; /* smaller padding */
  border-radius: 999px;
  display: inline-block;
}


.devlog-card:hover {
  background: var(--color-6);
}
</style>

---
const { entry } = Astro.props;
const { title, date, description, pinned, tags } = entry.data;
---

<article
  class="devlog-card"
  data-title={title}
  data-date={date}
  data-body={entry.body || ''}
  data-tags={tags?.join(',') || ''}
  data-pinned={pinned ? 'true' : 'false'}
>

  {pinned && <span class="pinned-badge">Pinned</span>}

  <h2>{title}</h2>
  <p>{description}</p>

  <div class="card-footer">
    <small class="card-date">{date}</small>

    {tags?.length > 0 && (
      <span class="card-tags">
        {tags.map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </span>
    )}
  </div>
</article>

<style>
/* ===== Card ===== */
.devlog-card {
  padding: 0.6rem 0.8rem;
  border: 2px solid var(--border-sidebar);
  border-radius: 8px;
  margin-bottom: 0.6rem;
  cursor: pointer;
  transition: background 0.2s ease;
  font-size: 0.85rem;
  position: relative;
}

.devlog-card:hover {
  background: var(--color-6);
}

/* ===== Pin Badge ===== */
.pinned-badge {
  position: absolute;
  top: 6px;
  right: 6px;
  background: var(--color-2);
  padding: 2px 6px;
  color: white;
  border-radius: 4px;
  font-size: 0.65rem;
}

/* ===== Title & Text ===== */
.devlog-card h2 {
  margin: 0 0 0.3rem;
  font-size: 1rem;
  color: var(--color-2);
}

.devlog-card p {
  margin: 0 0 0.3rem;
  font-size: 0.75rem;
  line-height: 1.2;
  color: var(--text-dark);
}

/* ===== Footer ===== */
.card-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.card-date {
  font-size: 0.65rem;
  color: var(--color-2);
}

/* ===== Tags ===== */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
}

.tag {
  background: var(--color-5);
  color: var(--text-main);
  font-size: 0.55rem;
  padding: 0.15rem 0.4rem;
  border-radius: 999px;
  display: inline-block;
}
</style>

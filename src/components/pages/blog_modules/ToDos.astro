<div class="todo-dashboard">
  <div class="todo-section">
    <div class="section-header">
      <h2>Pending Tasks</h2>
      <span class="badge count-pending" id="pendingCount">0</span>
    </div>
    <div class="card">
      <table class="todo-table" id="todoPending">
        <thead>
          <tr>
            <th>Task</th>
            <th class="center">Status</th>
            <th>Deadline</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      <div class="pagination" id="pendingPagination"></div>
    </div>
  </div>

  <div class="todo-section">
    <div class="section-header">
      <h2>Completed Tasks</h2>
      <span class="badge count-completed" id="completedCount">0</span>
    </div>
    <div class="card">
      <table class="todo-table" id="todoCompleted">
        <thead>
          <tr>
            <th>Task</th>
            <th class="center">Status</th>
            <th>Deadline</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      <div class="pagination" id="completedPagination"></div>
    </div>
  </div>
</div>

<style>
/* Modern Layout Grid */
.todo-dashboard {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 1rem;
}

.badge {
  background: var(--color-1, #ddd);
  padding: 2px 10px;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: bold;
}

.card {
  background: var(--color-7, #fff);
  border-radius: 12px;
  padding: 1rem;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  border: 1px solid rgba(0,0,0,0.05);
}

/* Table Refinement */
.todo-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 8px;
}

.todo-table th {
  padding: 0.5rem 1rem;
  color: #888;
  font-size: 0.75rem;
  text-transform: uppercase;
  border: none;
  text-align: left;
}

.todo-table td {
  padding: 1rem;
  background: var(--color-6, #f9f9f9);
}

/* Adjusted Rounded corners since first cell is now 'Task' */
.todo-table tr td:first-child { border-radius: 8px 0 0 8px; }
.todo-table tr td:last-child { border-radius: 0 8px 8px 0; }

.todo-table .center { text-align: center; }

/* Status Icon Styling */
.status-icon {
  width: 24px;
  height: 24px;
  transition: transform 0.2s ease;
}

.status-icon:hover {
  transform: scale(1.1);
}

@media (max-width: 600px) {
  .todo-dashboard { grid-template-columns: 1fr; }
}
</style>

<script>
const sheetUrl = "https://docs.google.com/spreadsheets/d/1ES17eiwj-H6BEgax-BcyhYkG3qRaqg4KHsHpz3oeu2s/export?format=csv";

let pendingTasks = [];
let completedTasks = [];
let pendingPage = 1;
let completedPage = 1;
let itemsPerPage = 6;

function calculateDynamicItems() {
  const rowHeight = 150;
  const overhead = 300;
  const availableHeight = window.innerHeight - overhead;
  itemsPerPage = Math.max(Math.floor(availableHeight / rowHeight), 3);
}

async function loadToDoData() {
  try {
    const response = await fetch(sheetUrl);
    const csvText = await response.text();
    const rows = csvText.split('\n').slice(4); 

    pendingTasks = [];
    completedTasks = [];

    rows.forEach(row => {
      const cols = row.split(",");
      if (cols.length < 3) return;

      const isChecked = cols[0].trim() === "✔" || cols[0].trim().toLowerCase() === "true";
      const item = {
        checked: isChecked,
        deadline: cols[1] || "",
        task: cols[2] || ""
      };

      if (isChecked) completedTasks.push(item);
      else pendingTasks.push(item);
    });

    calculateDynamicItems();
    renderTables();
  } catch (err) {
    console.error("Error loading To Do table:", err);
  }
}

function renderTables() {
  renderTable("todoPending", pendingTasks, pendingPage, "pending");
  renderTable("todoCompleted", completedTasks, completedPage, "completed");
}

function renderTable(tableId, list, page, type) {
  const tbody = document.querySelector(`#${tableId} tbody`);
  tbody.innerHTML = "";

  document.getElementById(`${type}Count`).textContent = list.length;

  const start = (page - 1) * itemsPerPage;
  const end = start + itemsPerPage;
  const pageItems = list.slice(start, end);

  pageItems.forEach((item, index) => {
    const tr = document.createElement("tr");
    tr.style.backgroundColor = index % 2 === 0 ? "var(--color-6)" : "var(--color-7)";

    // Task cell (Now the first cell)
    const tdTask = document.createElement("td");
    tdTask.textContent = item.task;
    tdTask.style.padding = "0.8rem 1rem";
    tdTask.style.color = "var(--text-dark)";
    if (item.checked) tdTask.style.textDecoration = "line-through";
    tr.appendChild(tdTask);

    // Status cell
    const tdStatus = document.createElement("td");
    tdStatus.style.textAlign = "center";
    tdStatus.style.padding = "0.8rem 1rem";
    const icon = document.createElement("img");
    icon.src = item.checked ? "checkmark-check.svg" : "checkmark-empty.svg";
    icon.alt = item.checked ? "Checked" : "Empty";
    icon.style.width = "30px";
    icon.style.height = "30px";
    icon.style.filter = "brightness(var(--invert))";
    tdStatus.appendChild(icon);
    tr.appendChild(tdStatus);

    // Deadline cell
    const tdDeadline = document.createElement("td");
    tdDeadline.textContent = item.deadline;
    tdDeadline.style.padding = "0.8rem 1rem";
    tr.appendChild(tdDeadline);

    tbody.appendChild(tr);
  });

  renderPagination(type, list.length, page);
}

function renderPagination(type, totalItems, currentPage) {
  const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
  const container = document.getElementById(`${type}Pagination`);
  container.innerHTML = ""; 
  container.style.display = totalPages > 1 ? "flex" : "none";
  container.style.justifyContent = "center";
  container.style.alignItems = "center";
  container.style.gap = "0.5rem";
  container.style.marginTop = "1rem";

  const prevBtn = document.createElement("button");
  prevBtn.textContent = "Previous";
  prevBtn.disabled = currentPage === 1;
  stylePaginationButton(prevBtn);
  prevBtn.onclick = () => changePage(type, -1);
  container.appendChild(prevBtn);

  const pageInfo = document.createElement("span");
  pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
  pageInfo.style.padding = "0.1rem 0.5rem";
  pageInfo.style.fontSize = "0.9rem";
  pageInfo.style.color = "var(--text-dark)";
  container.appendChild(pageInfo);

  const nextBtn = document.createElement("button");
  nextBtn.textContent = "Next";
  nextBtn.disabled = currentPage === totalPages;
  stylePaginationButton(nextBtn);
  nextBtn.onclick = () => changePage(type, 1);
  container.appendChild(nextBtn);
}

function stylePaginationButton(btn) {
  btn.style.padding = "0.1rem 0.5rem";
  btn.style.backgroundColor = "var(--color-1)";
  btn.style.color = "var(--text-dark)";
  btn.style.border = "2px solid var(--color-1)";
  btn.style.borderRadius = "10px";
  btn.style.cursor = "pointer";
  btn.style.fontSize = "0.9rem";
  btn.style.transition = "0.2s";
  if (btn.disabled) {
    btn.style.opacity = "0.5";
    btn.style.cursor = "not-allowed";
  }
}

function changePage(type, direction) {
  if (type === "pending") pendingPage += direction;
  else completedPage += direction;
  renderTables();
}

window.addEventListener("resize", () => {
  calculateDynamicItems();
  renderTables();
});

window.addEventListener("DOMContentLoaded", loadToDoData);

const refreshBtn = document.getElementById("refreshTodo");
if(refreshBtn) {
    refreshBtn.addEventListener("click", () => {
      pendingPage = 1;
      completedPage = 1;
      loadToDoData();
    });
}
</script>
---
import Container from "/src/components/WideContainer.astro";
import Drawbox from "./visitor_lounge/drawbox.astro";
import Textbox from "./visitor_lounge/textbox.astro";
---
<main class="content">
  <Container variant="static" class="container-with-bg">
    <div class="background-clip"></div>

    <div class="title-divider">
      <div class="line"></div>
      <h1 id="tab-title">Visitor's Lounge</h1>
      <div class="line"></div>
    </div>

    <p class="intro">
      Thanks for stopping by my website! You can drop your drawings or messages here, and they’ll show up automatically. Just be cool and respectful, anything inappropriate will be taken down.
    </p>

    <!-- TAB BUTTONS -->
    <div class="visitor-tab">
      <button class="tab-btn active" data-tab="drawbox">Drawing Board</button>
      <button class="tab-btn" data-tab="textbox">Message Board</button>
    </div>

    <!-- TAB CONTENT -->
    <div class="tab-content">
      <div id="drawbox" class="tab-panel active">
        <Drawbox />
      </div>

      <div id="textbox" class="tab-panel">
	  <div id="text-rules">
			<p>NOTE : The message board is for feedback / compliments / criticisms of my service / website! <strong>Do not contact me here under any circumstances.</strong> "One Question - One Answer" messages are allowed though, Thank you! :D</p>
			</div>
        <Textbox />
      </div>
    </div>

  </Container>
</main>

<style>
/* -------- TAB STYLES -------- */

main.content {
  flex: 1;
  margin-left: 260px;
  padding: 2rem;
  color: var(--text-dark);
}

.visitor-tab {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
  margin: 1rem 0;
}

.visitor-tab .tab-btn {
  padding: 0.5rem 1rem;
  background: var(--color-4);
  border: 2px solid var(--color-4);
  border-radius: 0.5rem;
  cursor: pointer;
  color: var(--text-dark);
  transition: 0.2s;
}

.visitor-tab .tab-btn.active {
  background: var(--color-6);
}

#text-rules {
  padding: 0.5rem;
  width: 74%;
  font-size: 12px;
  color: var(--text-dark);
  margin: 0 auto; /* centers it */
  text-align: center;    /* centers the text */
}

/* -------- TAB PANELS -------- */
.tab-panel {
  display: none;
  /* Ensure the animation doesn't cause layout jumps */
  opacity: 0; 
}

.tab-panel.active {
  display: block;
  /* Apply the animation here */
  animation: circUp 0.5s cubic-bezier(0, 0.55, 0.45, 1) forwards;
}

/* -------- ANIMATION DEFINITION -------- */
@keyframes circUp {
  from {
    opacity: 0;
    transform: translateY(5px); /* Starts 20px lower */
  }
  to {
    opacity: 1;
    transform: translateY(0);    /* Ends at original position */
  }
}


h1 { 
  font-size: 1.8rem; 
  margin-bottom: 1rem; 
  color: var(--color-1); 
}

.title-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -1rem;
  gap: 1rem;
}

.title-divider .line {
  flex: 1;
  height: 2px;
  background-color: var(--color-6); /* adjust to visible color */
  opacity: 1;
  transform: scaleX(1);
}

/* Mobile */
@media (max-width: 900px) {
  main.content {
    margin-left: 0;
    margin-top: 0.5rem;
    padding: 0rem;
  }

  h1 {
    font-size: 1rem;
    text-align: center;
  }
}
</style>

<!-- TAB LOGIC -->
<script>
document.querySelectorAll(".tab-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    // remove old actives
    document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));

    // set new active
    btn.classList.add("active");
    document.getElementById(btn.dataset.tab).classList.add("active");
  });
});

document.querySelectorAll(".tab-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    // remove old actives
    document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));

    // set new active
    btn.classList.add("active");
    const target = document.getElementById(btn.dataset.tab);
    if (target) {
      target.classList.add("active");
    }
  });
});
</script>

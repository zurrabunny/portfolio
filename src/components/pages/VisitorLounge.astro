---
import Container from "/src/components/Container.astro";
import Drawbox from "./visitor_lounge/drawbox.astro";
import Textbox from "./visitor_lounge/textbox.astro";
---

<main class="content">
  <Container variant="static" class="container-with-bg">
    <div class="background-clip">
    </div>

    <div class="title-divider">
      <div class="line"></div>
      <h1 id="tab-title">
        Visitor's Lounge
      </h1>
      <div class="line"></div>
    </div>
	
	<p class="intro">
        This section is currently in progress! Come back later!
    </p>
	
	<Drawbox />
	<Textbox />
	
  </Container>
</main>

<style>
p, ul, li {
color: var(--text-dark);
}

main.content {
  flex: 1;
  margin-left: 260px;
  padding: 2rem;
  background: none;
  color: var(--text-dark);
  position: relative;
  z-index: 1;
}
h1 { font-size: 1.8rem; margin-bottom: 1rem; color: var(--color-1); }
h2 { font-size: 1.3rem; color: var(--color-2); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem; font-weight: 600; position: relative; }
h2::before, h2::after { content: ""; flex-grow: 1; height: 2px; background-color: var(--color-5); opacity: 0.5; }
h2::before { margin-right: 0.75rem; }
h2::after { margin-left: 0.75rem; }

/* Mobile adjustments */
@media (max-width: 900px) {
  main.content {
    margin-left: 0;          /* Remove sidebar offset */
    padding: 1rem;           /* Reduce padding */
  }

  .contact-card {
    max-width: 100%;          /* Fill screen width */
    padding: 1rem;            /* Reduce padding */
    margin-inline: 0.5rem;    /* Small side margins */
    box-shadow: 0 2px 6px rgba(0,0,0,0.05); /* lighter shadow for small screens */
  }

  h1 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
	text-align: center;
  }

  h2 {
    font-size: 1rem;
    gap: 0.5rem;
  }

  .intro {
    font-size: 0.95rem;
    line-height: 1.5;
  }
}

/* Title divider styling */
.title-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
  gap: 1rem;
}
.title-divider .line {
  flex: 1;
  height: 2px;
  background-color: var(--color-6);
  opacity: 0;
  transform: scaleX(0);
  transform-origin: center;
}
#tab-title {
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  margin: 0;
  white-space: nowrap;
  display: flex;
  justify-content: center;
}
#tab-title span {
  display: inline-block;
  opacity: 0;
}

/* Mobile adjustments */
@media (max-width: 900px) {
  #tab-title {
    font-size: 1.5rem;
    text-align: center;
    white-space: normal;
  }
  .title-divider {
    gap: 0.5rem;
  }
  .title-divider .line {
    height: 1px;
  }
}

</style>

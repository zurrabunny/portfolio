<style>
/* ---------- Layout Containers ---------- */
.studio-container {
  max-width: 1000px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.studio-main {
  display: flex;
  gap: 1.5rem;
  background: var(--color-6);
  padding: 1.5rem;
  border-radius: 1.2rem;
  border: 2px solid var(--color-5);
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

/* ---------- Sidebar Controls ---------- */
#controls {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  min-width: 220px;
}

.control-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.control-group label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-1);
  letter-spacing: 0.05em;
}

/* ---------- Styled Inputs ---------- */
input[type="color"] {
  -webkit-appearance: none;
  width: 100%;
  height: 45px;
  border: 2px solid var(--color-5);
  border-radius: 10px;
  cursor: pointer;
  background: #fff;
  padding: 4px;
  transition: transform 0.2s;
}

select#brush-type {
  padding: 10px;
  border-radius: 10px;
  border: 2px solid var(--color-5);
  background: #fff;
  font-weight: 600;
  color: var(--color-3);
  cursor: pointer;
}

input[type="range"] {
  width: 100%;
  accent-color: var(--color-2);
}

/* ---------- Canvas ---------- */
#drawboxcanvas {
  border: 2px solid var(--color-5);
  border-radius: 0.8rem;
  background: #ffffff;
  cursor: crosshair;
  cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><line x1="8" y1="0" x2="8" y2="16" stroke="black" stroke-width="2"/><line x1="0" y1="8" x2="16" y2="8" stroke="black" stroke-width="2"/></svg>') 8 8, crosshair;
  flex-grow: 1;
  max-width: 100%;
  height: auto;
  touch-action: none; 
}

/* ---------- Buttons ---------- */
.btn-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
}

button {
  background: var(--color-5);
  color: var(--color-3);
  border: 2px solid var(--color-5);
  border-radius: 0.8rem;
  padding: 0.7rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

button:hover {
  background: var(--color-3);
  color: var(--text-main);
  border-color: var(--color-2);
}

button#submit {
  grid-column: span 2;
  background: var(--color-2);
  color: white;
  border: none;
  margin-top: 0.5rem;
}

/* ---------- Gallery Header ---------- */
.submitted-header {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 2px solid var(--color-5);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .studio-main { flex-direction: column; }
  #controls { order: 2; width: 100%; }
}
</style>

<div class="studio-container">
  <div class="studio-main">
    <div id="controls">
      <div class="control-group">
        <label>Color</label>
        <input id="color-picker" type="color" value="#000000">
      </div>

      <div class="control-group">
        <label>Brush Type</label>
        <select id="brush-type">
          <option value="marker">Marker</option>
          <option value="calligraphy">Calligraphy</option>
          <option value="watercolor">Watercolor</option>
          <option value="airbrush">Airbrush</option>
          <option value="eraser">Eraser</option>
        </select>
      </div>

      <div class="control-group">
        <label>Size</label>
        <input id="stroke-width" type="range" min="1" max="100" value="5">
      </div>

      <div class="btn-grid">
        <button id="undo">Undo</button>
        <button id="clear">Clear</button>
        <button id="submit">Submit Drawing</button>
      </div>
      
      <p id="status"></p>
    </div>

    <canvas id="drawboxcanvas" width="600" height="500"></canvas>
  </div>

  <div class="submitted-header">
    <h1>Gallery</h1>
    <button id="refreshGallery" class="refresh-btn">Refresh Feed</button>
  </div>

  <div id="gallery">Loading images...</div>
  <div id="pagination"></div>
</div>

<script>
/* -------------------- CONFIG -------------------- */
const GOOGLE_FORM_ID = "1FAIpQLSe3PhmUxhX1yPQuCMdNnKeY1jyitslfUYSrmHWEUyQv9XDWBQ";
const ENTRY_ID = "entry.1608675754";
const GOOGLE_SHEET_ID = "1dPzjW19MCo1EMnOt-xCu7LEwwIfC4b5rli6Sbii8_4I";
const DISPLAY_IMAGES = true;
const CLIENT_ID = "b4fb95e0edc434c";
const GOOGLE_SHEET_URL = `https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/export?format=csv`;
const GOOGLE_FORM_URL = `https://docs.google.com/forms/d/e/${GOOGLE_FORM_ID}/formResponse`;

/* -------------------- SHARED FUNCTIONS -------------------- */
function isDarkMode() {
  return document.documentElement.classList.contains("dark-mode");
}

function spawnConfetti(x, y, count = 20) {
  for (let i = 0; i < count; i++) {
    const confetti = document.createElement("div");
    const lightColors = ["#FFB3BA","#FFDFBA","#FFFFBA","#BAFFC9","#BAE1FF","#E0BAFF","#FFFFFF"];
    const darkColors = ["#FF6B6B","#FFA86B","#FFF56B","#6BFF8F","#6BD0FF","#B36BFF","#FF6BE3"];

    confetti.style.backgroundColor = (isDarkMode() ? lightColors : darkColors)[Math.floor(Math.random() * 7)];
    confetti.style.width = `${8 + Math.random() * 10}px`;
    confetti.style.height = `${8 + Math.random() * 10}px`;
    confetti.style.opacity = "0.9";
    confetti.style.borderRadius = "3px";
    confetti.style.position = "fixed";
    confetti.style.left = "0px";
    confetti.style.top = "0px";
    confetti.style.pointerEvents = "none";
    confetti.style.zIndex = 10000;
    document.body.appendChild(confetti);

    let posX = 0, posY = 0;
    const velocityX = (Math.random() - 0.5) * 15;
    let velocityY = Math.random() * -15 - 5;
    const gravity = 0.5;
    const rotationSpeed = (Math.random() - 0.5) * 20;
    let rotation = 0;

    function animate() {
      velocityY += gravity;
      posX += velocityX;
      posY += velocityY;
      rotation += rotationSpeed;
      confetti.style.transform = `translate(${x + posX}px, ${y + posY}px) rotate(${rotation}deg)`;
      if (y + posY < window.innerHeight + 100) requestAnimationFrame(animate);
      else confetti.remove();
    }
    animate();
  }
}

/* -------------------- CANVAS SETUP -------------------- */
const canvas = document.getElementById("drawboxcanvas");
const context = canvas.getContext("2d");
context.fillStyle = "white";
context.fillRect(0, 0, canvas.width, canvas.height);

let restore_array = [];
let start_index = -1;
let stroke_color = "#000000";
let stroke_width = 5;
let current_brush = "marker";
let is_drawing = false;
let lastX = 0;
let lastY = 0;

function start(event) {
  is_drawing = true;
  document.body.style.overflow = "hidden";
  [lastX, lastY] = [getX(event), getY(event)];
  context.beginPath();
  context.moveTo(lastX, lastY);
  if (event.touches) event.preventDefault();
}

function draw(event) {
  if (!is_drawing) return;
  const x = getX(event);
  const y = getY(event);

  context.strokeStyle = current_brush === "eraser" ? "#FFFFFF" : stroke_color;
  context.lineWidth = stroke_width;
  context.lineJoin = "round";
  context.lineCap = "round";

  if (current_brush === "marker" || current_brush === "eraser") {
    context.globalAlpha = 1.0;
    context.beginPath();
    context.moveTo(lastX, lastY);
    context.lineTo(x, y);
    context.stroke();
  } 
  else if (current_brush === "calligraphy") {
    context.globalAlpha = 1.0;
    for (let i = 0; i < stroke_width; i++) {
        context.beginPath();
        context.moveTo(lastX + i, lastY + i);
        context.lineTo(x + i, y + i);
        context.stroke();
    }
  }
  else if (current_brush === "watercolor") {
    context.globalAlpha = 0.05;
    context.shadowBlur = stroke_width / 2;
    context.shadowColor = stroke_color;
    context.beginPath();
    context.moveTo(lastX, lastY);
    context.lineTo(x, y);
    context.stroke();
    context.shadowBlur = 0;
  }
  else if (current_brush === "airbrush") {
    context.globalAlpha = 0.15;
    const density = 25;
    for (let i = 0; i < density; i++) {
      const offsetX = (Math.random() - 0.5) * (stroke_width * 2.5);
      const offsetY = (Math.random() - 0.5) * (stroke_width * 2.5);
      context.fillStyle = stroke_color;
      context.fillRect(x + offsetX, y + offsetY, 1, 1);
    }
  }

  [lastX, lastY] = [x, y];
  if (event.cancelable) event.preventDefault();
}

function stop(event) {
  if (!is_drawing) return;
  document.body.style.overflow = "auto";
  context.stroke();
  context.closePath();
  is_drawing = false;
  context.globalAlpha = 1.0; 
  restore_array.push(context.getImageData(0, 0, canvas.width, canvas.height));
  start_index++;
}

let getX = (event) => {
  const rect = canvas.getBoundingClientRect();
  const clientX = (event.touches ? event.touches[0].clientX : event.clientX);
  return (clientX - rect.left) * (canvas.width / rect.width);
};
let getY = (event) => {
  const rect = canvas.getBoundingClientRect();
  const clientY = (event.touches ? event.touches[0].clientY : event.clientY);
  return (clientY - rect.top) * (canvas.height / rect.height);
};

canvas.addEventListener("touchstart", start, {passive: false});
canvas.addEventListener("touchmove", draw, {passive: false});
canvas.addEventListener("touchend", stop);
canvas.addEventListener("mousedown", start);
window.addEventListener("mousemove", (e) => { if(is_drawing) draw(e); });
window.addEventListener("mouseup", (e) => { if(is_drawing) stop(e); });

function Restore() {
  if (start_index <= 0) { Clear(true); } 
  else { 
    start_index--; 
    restore_array.pop(); 
    context.putImageData(restore_array[start_index], 0, 0); 
  }
}

function Clear(isUndo = false) {
  if (!isUndo) {
    const confirmClear = confirm("Are you sure you want to clear your drawing?");
    if (!confirmClear) return;
  }
  context.fillStyle = "white";
  context.fillRect(0, 0, canvas.width, canvas.height);
  restore_array = [];
  start_index = -1;
}

/* -------------------- UI ACTIONS -------------------- */
document.querySelector('#submit')?.addEventListener('click', async function () {
  const btn = this;
  const status = document.getElementById("status");
  const rect = btn.getBoundingClientRect();
  
  btn.disabled = true;
  status.textContent = "Uploading...";
  
  try {
    const imageData = canvas.toDataURL("image/png");
    const blob = await (await fetch(imageData)).blob();
    const formData = new FormData();
    formData.append("image", blob, "drawing.png");
    
    const response = await fetch("https://api.imgur.com/3/image", {
      method: "POST",
      headers: { Authorization: `Client-ID ${CLIENT_ID}` },
      body: formData,
    });
    const data = await response.json();
    if (!data.success) throw new Error("Upload failed");

    const googleFormData = new FormData();
    googleFormData.append(ENTRY_ID, data.data.link);
    await fetch(GOOGLE_FORM_URL, { method: "POST", body: googleFormData, mode: "no-cors" });
    
    status.textContent = "Submitted!";
    
    // Trigger Effects Instead of Reload
    spawnConfetti(rect.left + rect.width / 2, rect.top + rect.height / 2, 40);
    fetchImages(); // Refresh the gallery
    Clear(true);   // Clear the canvas for the next drawing
    
    setTimeout(() => { 
        status.textContent = ""; 
        btn.disabled = false;
    }, 3000);

  } catch (error) {
    status.textContent = "Error occurred.";
    btn.disabled = false;
  }
});

document.querySelector('#undo')?.addEventListener('click', Restore);
document.querySelector('#clear')?.addEventListener('click', () => Clear(false));
document.getElementById('color-picker')?.addEventListener('input', (e) => { stroke_color = e.target.value; });
document.getElementById('stroke-width')?.addEventListener('input', (e) => { stroke_width = parseInt(e.target.value); });
document.getElementById('brush-type')?.addEventListener('input', (e) => { current_brush = e.target.value; });

/* -------------------- GALLERY -------------------- */
let currentPage = 1;
const itemsPerPage = 15;
let allImages = [];

async function fetchImages() {
  if (!DISPLAY_IMAGES) return;
  try {
    const response = await fetch(GOOGLE_SHEET_URL + '&cachebust=' + Date.now());
    const csvText = await response.text();
    const rows = csvText.split("\n").slice(1);
    allImages = [];

    rows.reverse().forEach((row) => {
      const columns = row.split(",");
      if (columns.length < 2) return;
      const imgUrl = columns[1].trim().replace(/"/g, "");
      if (imgUrl.startsWith("http")) { 
        allImages.push({ 
          timestamp: columns[0].trim(), 
          imgUrl, 
          isLiked: columns[2]?.trim().toLowerCase() === "true" 
        }); 
      }
    });
    displayPage(1);
  } catch (e) {
    document.getElementById("gallery").textContent = "Failed to load drawings.";
  }
}

function displayPage(page) {
  currentPage = page;
  const gallery = document.getElementById("gallery");
  gallery.innerHTML = "";
  
  Object.assign(gallery.style, {
    display: 'grid',
    gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))',
    gap: '1.5rem',
    marginTop: '1.5rem'
  });

  const startIndex = (page - 1) * itemsPerPage;
  const pageItems = allImages.slice(startIndex, startIndex + itemsPerPage);

  pageItems.forEach(({ timestamp, imgUrl, isLiked }) => {
    const card = document.createElement("div");
    Object.assign(card.style, {
      background: 'var(--color-6)',
      border: '2px solid var(--color-5)',
      borderRadius: '1rem',
      padding: '10px',
      position: 'relative',
      transition: 'transform 0.2s',
      textAlign: 'center'
    });

    if (isLiked) {
      const heart = document.createElement("img");
      heart.src = "heart.svg"; 
      Object.assign(heart.style, {
        position: "absolute", top: "-8px", right: "-8px", width: "32px", height: "32px", zIndex: "2"
      });
      card.append(heart);
    }

    const img = document.createElement("img");
    img.src = imgUrl;
    Object.assign(img.style, {
      width: '100%', height: '160px', objectFit: 'contain', borderRadius: '0.5rem', background: '#fff'
    });
    
    const p = document.createElement("p");
    p.textContent = timestamp;
    Object.assign(p.style, { fontSize: '0.7rem', color: '#666', marginTop: '8px' });

    card.append(img, p);
    gallery.appendChild(card);
  });
  renderPaginationControls();
}

function renderPaginationControls() {
  const pagination = document.getElementById("pagination");
  pagination.innerHTML = "";
  const totalPages = Math.ceil(allImages.length / itemsPerPage);
  if (totalPages <= 1) return;

  for (let i = 1; i <= totalPages; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;
    Object.assign(btn.style, {
      margin: '10px 4px', padding: '0.4rem 0.8rem',
      background: i === currentPage ? 'var(--color-1)' : 'var(--color-5)',
      color: i === currentPage ? '#fff' : 'var(--color-3)',
      borderRadius: '0.5rem'
    });
    btn.onclick = () => {
      displayPage(i);
      document.querySelector('.submitted-header').scrollIntoView({ behavior: 'smooth' });
    };
    pagination.appendChild(btn);
  }
}

document.getElementById("refreshGallery")?.addEventListener("click", fetchImages);
fetchImages();
</script>

<button class="cookie-toggle" id="cookie-toggle" aria-label="Cookie Clicker">
  <svg class="icon cookie" width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M20.5056 10.7754C21.1225 10.5355 21.431 10.4155 21.5176 10.2459C21.5926 10.099 21.5903 9.92446 21.5115 9.77954C21.4205 9.61226 21.109 9.50044 20.486 9.2768L4.59629 3.5728C4.0866 3.38983 3.83175 3.29835 3.66514 3.35605C3.52029 3.40621 3.40645 3.52004 3.35629 3.6649C3.29859 3.8315 3.39008 4.08635 3.57304 4.59605L9.277 20.4858C9.50064 21.1088 9.61246 21.4203 9.77973 21.5113C9.92465 21.5901 10.0991 21.5924 10.2461 21.5174C10.4157 21.4308 10.5356 21.1223 10.7756 20.5054L13.3724 13.8278C13.4194 13.707 13.4429 13.6466 13.4792 13.5957C13.5114 13.5506 13.5508 13.5112 13.5959 13.479C13.6468 13.4427 13.7072 13.4192 13.828 13.3722L20.5056 10.7754Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <svg class="icon close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
  </svg>
</button>

<div class="cookie-panel" id="cookie-panel" hidden>
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="cookie-count">Bubby Clicker</div>
      <div class="divider"></div>
      <img src="bubby/bubby.gif" alt="Bubby" class="bubby" id="bubby-click" draggable="false" />
      <div class="divider"></div>
      <div class="cookie-count">Bubbys : <span id="cookie-count">0</span></div>
      <div class="divider"></div>
      <button id="bubby-upgrade" class="bubby-upgrade">+1 per click (100)</button>
      <div class="confetti-panel">
        <label for="confetti-count">Confetti per click:</label>
        <input type="number" id="confetti-count" min="1" max="20" value="2">
      </div>
      <label class="sound-toggle-label">Play Boop Sound <input type="checkbox" id="sound-toggle"></label>
    </div>
    <div id="skin-selector"></div>
  </div>
</div>

<style>
/* Clicker Styles */
.bubby-upgrade { margin-top: 10px; padding: 8px 12px; width: 100%; border-radius: 8px; background: var(--color-3); cursor: pointer; }
.cookie-toggle { position: fixed; z-index: 9999; width: 44px; height: 44px; border-radius: 12px; background: var(--color-8); cursor: pointer; right: 20px; bottom: 20px; }
.cookie-panel { position: fixed; bottom: 80px; right: 20px; width: 350px; padding: 20px; background: var(--bg-sidebar); border: 4px solid var(--color-6); border-radius: 14px; box-shadow: 0 10px 24px rgba(0,0,0,0.3); z-index: 9999; opacity: 0; transform: translateY(10px); transition: all 0.3s; }
.cookie-panel.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
.bubby { width: 100%; border-radius: 10px; cursor: pointer; transition: transform 0.06s; }
.divider { margin: 10px 0; height: 1px; background: #eee; }
#skin-selector { display: flex; flex-direction: column; gap: 6px; max-height: 300px; overflow-y: auto; padding-left: 10px; }
@media (max-width: 900px) { .cookie-toggle, .cookie-panel { display: none !important; } }
</style>

<script>
// Logic for Clicker (Bubby Clicker)
const toggle = document.getElementById("cookie-toggle");
const panel = document.getElementById("cookie-panel");
const countEl = document.getElementById("cookie-count");
const bubby = document.getElementById("bubby-click");
const confettiInput = document.getElementById("confetti-count");

let cookies = Number(localStorage.getItem("cookies") || 0);
countEl.textContent = cookies;

toggle.addEventListener("click", () => {
    panel.hidden = !panel.hidden;
    panel.classList.toggle("show");
});

bubby.addEventListener("click", (e) => {
    cookies += 1;
    countEl.textContent = cookies;
    localStorage.setItem("cookies", cookies);
    const count = Number(confettiInput.value) || 2;
    spawnConfetti(e.clientX, e.clientY, count);
    
    bubby.style.transform = "scale(0.95)";
    setTimeout(() => bubby.style.transform = "scale(1)", 50);
});
</script>
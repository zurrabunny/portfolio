<style>
/* ================= Split Layout ================= */
#main-wrapper {
  display: flex;
  gap: 1rem;
  max-width: 2000px;
  height: 600px;
  background: transparent;
  border-radius: 1rem;
  overflow: hidden;
}

/* ================= Left: Textbox Area ================= */
#textbox-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: transparent;
  padding: 1rem;
  box-sizing: border-box;
  border-radius: 1rem;
  overflow: hidden;
}

#username {
  width: 95.5%;
  padding: 0.6rem;
  padding-left: 1rem;
  margin-bottom: 1rem;
  border: 2px solid var(--color-6);
  border-radius: 0.8rem;
  background: var(--color-6);
  color: var(--text-dark);
  font-size: 16px;
}

#textcanvas {
  width: 100%;
  width: 100%;
  min-height: 80px;
  padding: 1rem;
  margin-bottom: 1rem;
  border: 2px solid var(--color-6);
  border-radius: 0.8rem;
  background: var(--color-6);
  font-size: 16px;
  color: var(--text-dark);
  font-family: inherit;
  resize: vertical;
  box-sizing: border-box;
}

#text-controls {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

#text-submit-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  justify-content: center;
}

/* ---------------- Buttons ---------------- */
.text-button,
.refresh-btn {
  padding: 0.6rem 1rem;
  margin: 0.5rem 0.25rem;
  font-weight: 600;
  cursor: pointer;
  border-radius: 0.8rem;
  border: 2px solid var(--color-5);
  transition: all 0.25s ease;
}

.text-button {
  background: var(--color-5);
  color: var(--color-3);
}

.text-button:hover {
  background: var(--color-3);
  color: var(--text-main);
  border-color: var(--color-2);
}

.refresh-btn {
  background: var(--color-5);
  color: var(--color-3);
}

.refresh-btn:hover {
  background: var(--color-3);
  color: var(--text-main);
  border-color: var(--color-2);
}

#text-status {
  font-size: 0.9rem;
  color: #555;
  margin-bottom: 0.5rem;
  font-family: inherit;
}

/* ================= Right: Messages Area ================= */
#text-gallery-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  background: var(--color-6);
  border-left: 2px solid var(--color-6);
  border-radius: 0.8rem;
  padding: 1rem;
  overflow-y: auto;
  margin-top: 1rem;
}

.text-container-wrapper {
  position: relative;
}

.text-container {
  padding: 0.75rem;
  border: 2px solid #444;
  border-radius: 0.8rem;
  background: #eee;
  color: #000;
  white-space: pre-wrap;
  font-family: inherit;
}

.text-timestamp {
  margin-top: 0.4rem;
  font-size: 0.8rem;
  color: #555;
  font-family: inherit;
}

/* ================= Mobile Responsiveness ================= */
@media (max-width: 900px) {

  #main-wrapper {
    flex-direction: column;
    height: auto;
    max-width: 100%;
  }

  #textbox-wrapper {
    width: 100%;
    padding: 0.75rem;
  }

  #username {
    width: 92%;
    font-size: 1rem;
  }

  #textcanvas {
    min-height: 150px;
    width: 100%;
    font-size: 15px;
  }

  #text-controls {
    gap: 0.4rem;
  }

  .text-button {
    padding: 0.5rem 0.8rem;
    font-size: 0.9rem;
  }

  #text-gallery-wrapper {
    width: 90%;
    height: 350px;
    margin-top: 0.5rem;
    border-left: none;
    padding: 0.75rem;
	font-size: 12px;
  }

  .text-container {
    padding: 0.6rem;
    font-size: 0.9rem;
  }

  .text-timestamp {
    font-size: 0.75rem;
  }
}
</style>

<div id="main-wrapper">

  <!-- Left: Text Input -->
  <div id="textbox-wrapper">
    <input id="username" placeholder="Enter your name..." />
    <textarea id="textcanvas" placeholder="Type your text here..."></textarea>

    <div id="text-controls">
      <div id="text-submit-header">
        <button id="text-submit" class="text-button">Submit Text</button>
        <button id="refreshTexts" class="refresh-btn">Refresh Board</button>
      </div>
    </div>

    <div id="text-status"></div>
  </div>

  <!-- Right: Message Gallery -->
  <div id="text-gallery-wrapper">
    <div id="text-gallery">Loading texts...</div>
  </div>

</div>

<script>
// CONFIG
const GOOGLE_FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLSdljLgmcLVCqx9Hwf2D49ZgDRYDEXkTV8w-7WyW1SLkTkMcdw/formResponse";
const ENTRY_ID = "entry.1206257935";
const GOOGLE_SHEET_CSV = "https://docs.google.com/spreadsheets/d/1cHqp4SpzJ-yAYaDDxwvrQvH0XYV1K09Tdcc-aXd7-gs/export?format=csv";

const textCanvas = document.getElementById("textcanvas");
const statusText = document.getElementById("text-status");
const gallery = document.getElementById("text-gallery");

function formatTimestamp(date) {
  const d = date || new Date();
  return `${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}/${d.getFullYear()} – ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
}

function addTextToGallery(name, text, timestamp, liked = false) {
  const wrapper = document.createElement("div");
  wrapper.className = "text-container-wrapper";
  wrapper.style.position = "relative"; // ensure relative positioning

  const container = document.createElement("div");
  container.className = "text-container";

  const message = document.createElement("div");
  message.textContent = `${name}: ${text}`;

  const time = document.createElement("div");
  time.className = "text-timestamp";
  time.textContent = timestamp || formatTimestamp();

  container.appendChild(message);
  container.appendChild(time);
  wrapper.appendChild(container);

  // Add heart if liked
  if (liked) {
    const heart = document.createElement("img");
    heart.src = "heart.svg"; // path to your heart SVG
    heart.style.position = "absolute";
    heart.style.top = "-4px";     
    heart.style.right = "-10px";   
    heart.style.width = "30px";    
    heart.style.height = "30px";   
    heart.style.cursor = "pointer";
    heart.style.pointerEvents = "auto"; 
    heart.style.zIndex = "10";
	
	if (window.innerWidth <= 900) {
        heart.style.display = "none";
    }
	
    // Create hover bubble
    const bubble = document.createElement("div");
    bubble.textContent = "Liked by Zurrabunny!";
    bubble.style.position = "absolute";
    bubble.style.bottom = "100%";
    bubble.style.right = "50%";
    bubble.style.transform = "translateX(50%)";
    bubble.style.background = "var(--color-5)";
    bubble.style.color = "white";
    bubble.style.padding = "4px 8px";
    bubble.style.borderRadius = "6px";
    bubble.style.fontSize = "0.7rem";
    bubble.style.whiteSpace = "nowrap";
    bubble.style.pointerEvents = "none";
    bubble.style.opacity = "0";
    bubble.style.transition = "opacity 0.2s";

    // Show bubble on hover
    heart.addEventListener("mouseenter", () => bubble.style.opacity = "1");
    heart.addEventListener("mouseleave", () => bubble.style.opacity = "0");

    wrapper.appendChild(heart);
    wrapper.appendChild(bubble);
  }

  gallery.appendChild(wrapper);

  gallery.scrollTop = gallery.scrollHeight;
}



// SUBMIT HANDLER
document.getElementById("text-submit").addEventListener("click", async () => {
  const name = document.getElementById("username").value.trim();
  const text = textCanvas.value.trim();

  if (!name) {
    statusText.textContent = "Please enter your name first.";
    return;
  }

  // ❌ Block sending when the name is "ZurraBunny"
  if (name.toLowerCase() === "zurrabunny") {
    statusText.textContent = "You cant use my name! >:^";
    return;
  }

  if (!text) return;


  const timestamp = formatTimestamp();
  const combined = `${name}: ${text} || ${timestamp}`;
  statusText.textContent = "Submitting...";

  const formData = new FormData();
  formData.append(ENTRY_ID, combined);

  try {
    await fetch(GOOGLE_FORM_URL, { method: "POST", body: formData, mode: "no-cors" });
    addTextToGallery(name, text, timestamp);
    textCanvas.value = "";
    statusText.textContent = "Submitted successfully!";
  } catch (err) {
    statusText.textContent = "Error submitting text.";
  }
});

async function fetchTexts() {
  try {
    const response = await fetch(GOOGLE_SHEET_CSV);
    const csvText = await response.text();
    const rows = csvText.split("\n").slice(1);
    gallery.innerHTML = "";

    rows.forEach(row => {
      const columns = row.split(",");
      if (columns.length < 2) return;

      let raw = columns[1].replace(/"/g,"").trim();
      if (!raw) return;

      let [mainText, timestamp] = raw.split("||");
      if (!mainText || mainText.trim() === "") return;

      const name = mainText.split(":")[0] || "Anonymous";
      const messageText = mainText.split(":").slice(1).join(":").trim();
      if (!messageText) return;

      const liked = columns[2] && columns[2].trim().toLowerCase() === "true";

      // Column D → your reply
      const replyText = columns[3] ? columns[3].trim() : "";

      // wrapper for everything (message + reply + divider)
      const block = document.createElement("div");

      // message
      addTextToGallery(name, messageText, timestamp, liked);

      // reply (if exists)
      if (replyText !== "") {
        const replyBox = document.createElement("div");
        replyBox.style.margin = "6px 0 10px 20px";
        replyBox.style.padding = "10px";
        replyBox.style.border = "1px solid var(--color-4)";
        replyBox.style.background = "var(--color-6)";
        replyBox.style.borderRadius = "6px";
        replyBox.style.color = "var(--text-dark)";
        replyBox.textContent = `ZurraBunny replied: ${replyText}`;
        gallery.appendChild(replyBox);
      }

      // ✅ divider always goes LAST → right under reply or message
      const divider = document.createElement("hr");
      divider.style.border = "0";
      divider.style.height = "1px";
      divider.style.background = "var(--color-4)";
      divider.style.margin = "0.5rem 0";

      gallery.appendChild(divider);
    });

    gallery.scrollTop = gallery.scrollHeight;

  } catch (err) {
    gallery.textContent = "Failed to load texts.";
  }
}

document.getElementById("refreshTexts")?.addEventListener("click", () => {
  fetchTexts(); // reloads messages
});


fetchTexts();
</script>

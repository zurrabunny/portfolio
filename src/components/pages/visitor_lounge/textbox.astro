<style>
#textcanvas {
  border: 2px solid var(--color-5, #444);
  border-radius: 0.8rem;
  background: var(--color-6, #eee);
  padding: 1rem;
  min-height: 200px;
  max-width: 500px;
  margin: 1rem auto;
  overflow-y: auto;
  white-space: pre-wrap;
  outline: none;
  font-size: 16px;
  color: var(--text-main, #000);
  width: 100%;
  box-sizing: border-box;
  resize: vertical;
}

#controls {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

button {
  background: var(--color-5, #444);
  color: var(--color-3, #fff);
  border: 2px solid var(--color-5, #444);
  border-radius: 0.8rem;
  padding: 0.6rem 1rem;
  cursor: pointer;
}
button:hover {
  background: var(--color-3, #fff);
  color: var(--color-1, #000);
  border-color: var(--color-2, #f00);
}

#gallery {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 1rem;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

.text-container {
  border: 2px solid var(--color-5, #444);
  border-radius: 0.8rem;
  padding: 0.75rem;
  background: var(--color-6, #eee);
  white-space: pre-wrap;
  color: var(--text-main, #000);
}
</style>

<textarea id="textcanvas" placeholder="Type your text here..."></textarea>
<div id="controls">
  <button id="submit">Submit Text</button>
</div>

<div id="status"></div>
<div id="gallery">Loading texts...</div>

<script>
const textCanvas = document.getElementById("textcanvas");
const statusText = document.getElementById("status");

// Google Form config
const GOOGLE_FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLSdljLgmcLVCqx9Hwf2D49ZgDRYDEXkTV8w-7WyW1SLkTkMcdw/formResponse";
const ENTRY_ID = "entry.1206257935";

// Google Sheet CSV URL
const GOOGLE_SHEET_CSV = "https://docs.google.com/spreadsheets/d/1cHqp4SpzJ-yAYaDDxwvrQvH0XYV1K09Tdcc-aXd7-gs/export?format=csv";

// Submit text
document.getElementById("submit").addEventListener("click", async () => {
  const text = textCanvas.value.trim();
  if (!text) return;

  statusText.textContent = "Submitting...";
  const formData = new FormData();
  formData.append(ENTRY_ID, text);

  try {
    await fetch(GOOGLE_FORM_URL, {
      method: "POST",
      body: formData,
      mode: "no-cors"
    });

    // Add to gallery locally
    addTextToGallery(text);
    textCanvas.value = "";
    statusText.textContent = "Submitted successfully!";
  } catch (err) {
    console.error(err);
    statusText.textContent = "Error submitting text.";
  }
});

// Helper to add text to gallery
function addTextToGallery(text) {
  const gallery = document.getElementById("gallery");
  const div = document.createElement("div");
  div.classList.add("text-container");
  div.innerText = text;
  gallery.prepend(div);
}

// Fetch previous submissions from Google Sheet CSV
async function fetchTexts() {
  try {
    const response = await fetch(GOOGLE_SHEET_CSV);
    const csvText = await response.text();
    const rows = csvText.split("\n").slice(1); // skip header
    const gallery = document.getElementById("gallery");
    gallery.innerHTML = ""; // clear placeholder

    rows.reverse().forEach(row => {
      const columns = row.split(",");
      if (columns.length < 2) return;
      const text = columns[1].replace(/"/g, ""); // second column is text
      if (text) addTextToGallery(text);
    });
  } catch (err) {
    console.error("Error fetching texts:", err);
    document.getElementById("gallery").textContent = "Failed to load texts.";
  }
}

// Load texts on page load
fetchTexts();
</script>

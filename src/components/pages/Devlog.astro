---
import Container from "/src/components/WideContainer.astro";
import DevlogList from './devlog/DevlogList.astro';
import DevlogModal from './devlog/DevlogModal.astro';
---

<main class="content">
  <Container variant="static">
    <DevlogModal />

    <div class="goal-title-line">
      <div class="goal-line"></div>
      <h1 id="goal-title">Blogs</h1>
      <div class="goal-line"></div>
    </div>

    <p class="intro">
      Hear my ramblings! Whether that’s current or upcoming projects, brainstorms, events,
      creative processes, and more. I update this section from time to time!
    </p>

    <div class="devlog-wrapper">
      <DevlogList />
    </div>

  </Container>
</main>

<style>
/* ===== Base Layout ===== */
main.content {
  flex: 1;
  margin-left: 260px;
  padding: 2rem;
  color: var(--text-dark);
}

p {
  color: var(--text-dark);
}

h1 {
  font-size: 1.8rem;
  color: var(--color-1);
  margin-bottom: 1rem;
}

/* ===== Title Line ===== */
.goal-title-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.goal-line {
  flex: 1;
  height: 2px;
  background-color: var(--color-6);
}

#goal-title {
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  margin: 0;
  white-space: nowrap;
}

/* ===== Devlog layout ===== */
.devlog-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* ===== Mobile ===== */
@media (max-width: 900px) {
  main.content {
    margin: 0;
    padding: 0.5rem;
  }

  h1,
  #goal-title {
    font-size: 1.5rem;
    text-align: center;
    white-space: normal;
  }

  /* Body text scaling */
  p,
  li,
  span,
  a {
    font-size: 0.55rem;
    margin: 0.5rem 0;
  }

  .goal-title-line {
    gap: 0.5rem;
  }

  .goal-line {
    height: 1px;
  }
}
</style>

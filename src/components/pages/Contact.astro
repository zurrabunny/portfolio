<style>
/* 1. Wrapper with Offsets */
.card-perspective-wrapper {
  position: relative;
  /* Adjust these values to move the card's starting anchor point */
  top: 120px; 
  left: 130px;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

/* 2. Horizontal Card Design */
.business-card {
  position: relative;
  width: 600px; 
  min-height: 340px;
  padding: 3.5rem;
  border-radius: 1.5rem;
  background: var(--color-6, #ffffff);
  border: 2px solid var(--color-5, #e0e0e0);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
  transform-style: preserve-3d;
  opacity: 0;
}

/* Animation: Smooth deceleration (Circ Out) */
.slide-in {
  animation: handoverAction 1.2s cubic-bezier(0, 0.55, 0.45, 1) forwards;
}

@keyframes handoverAction {
  0% {
    opacity: 0;
    /* Starts from deep off-screen bottom with card-flip rotation */
    transform: translateY(120vh) rotateX(70deg) rotateY(-25deg) scale(0.6);
  }
  100% {
    opacity: 1;
    /* Final professional 'held out' position */
    transform: translateY(0) rotateX(12deg) rotateY(0deg) scale(1);
  }
}

/* 4. Link Styling */
.styled-link {
  color: var(--color-2, #5c67f2);
  text-decoration: none;
  font-weight: 600;
  position: relative;
  transition: color 0.3s ease;
}

.styled-link::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 2px;
  bottom: -2px;
  left: 0;
  background-color: var(--color-1, #ff7eb9);
  transform: scaleX(0);
  transform-origin: bottom right;
  transition: transform 0.3s ease-out;
}

.styled-link:hover {
  color: var(--color-1, #ff7eb9);
}

.styled-link:hover::after {
  transform: scaleX(1);
  transform-origin: bottom left;
}

.discord-tag {
  color: var(--text-dark, #333);
  background: rgba(0,0,0,0.05);
  padding: 2px 6px;
  font-size: 15px;
  border-radius: 4px;
  font-family: monospace;
}

/* Layout Utilities */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 2rem;
}

.title-divider {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.title-divider .line {
  flex: 1;
  height: 2px;
  background: var(--color-5);
}

h1 {
  font-size: 1.75rem;
  color: var(--color-2, #333);
  margin: 0;
}

h2 {
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--color-2, #5c67f2);
  margin-bottom: 0.75rem;
}

.intro {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--text-dark, #5c67f2);
}

.contact-info ul {
  list-style: none;
  color: var(--text-dark, #5c67f2);
  padding: 0;
  margin: 0;
}

.contact-info li {
  margin-bottom: 0.5rem;
}

/* Button */
.btn {
  background: var(--color-2, #5c67f2);
  color: white;
  padding: 0.8rem 1.8rem;
  border: none;
  border-radius: 50px; /* Pill shape */
  cursor: pointer;
  font-weight: bold;
  transition: all 0.1s ease;
  border: 2px solid transparent;
}

.btn:hover {
  background: var(--color-3, #5c67f2);
  border: 2px solid var(--color-5, #e0e0e0);
}

@media (max-width: 650px) {
  .business-card {
    width: 95%;
    padding: 1.5rem;
  }
  .card-footer {
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
}
</style>


<button class="typeface-toggle" id="typefaceing-toggle" aria-label="Typography Menu">
  <svg class="icon typeface" fill="#FFFFFF" height="150px" width="150px" version="1.1" viewBox="0 0 485 485">
<g>
  <path 
    d="M120 100 H365 M242.5 100 V400" 
    stroke="#FFFFFF" 
    stroke-width="60" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    fill="none" 
  />
</g>
  </svg>
  <svg class="icon close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
  </svg>
</button>

<div class="typeface-panel" id="typefaceing-panel" hidden>
  <div class="typefaceing-solid-wrapper">
    <div class="typefaceing-row" style="flex-direction: column; align-items: stretch;">
      <label for="text-font-select" class="text-font-label">Site Font</label>
      <select id="text-font-select" class="typefaceing-dropdown">
        <option value="inherit">Default Font</option>
        <option value="'Inter', sans-serif">Inter (Modern)</option>
        <option value="'Georgia', serif">Serif (Classic)</option>
        <option value="'Courier New', monospace">Monospace (Code)</option>
        <option value="'Comic Sans MS', cursive">Comic Sans</option>
      </select>
    </div>
  </div>
</div>

<style>
  /* 1. FORCE ALL ELEMENTS TO USE THE DYNAMIC FONT */
  :root {
    --global-typeface: inherit;
  }

  /* The !important ensures it overrides existing component styles */
  *, *::before, *::after {
    font-family: var(--global-typeface) !important;
  }

  /* 2. COMPONENT STYLES */
  .typeface-toggle {
    position: fixed; z-index: 9999; width: 44px; height: 44px; border: none; border-radius: 12px;
    background-color: var(--color-8, #333); display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background 0.3s ease;
  }
  .typeface-toggle:hover { background-color: var(--color-2, #555); }

  .icon {
    position: absolute; width: 25px; height: 25px; stroke: var(--text-main, #fff);
    transition: opacity 0.3s ease, transform 0.3s ease; pointer-events: none;
  }
  .typeface { opacity: 1; filter: brightness(var(--invert, 1)); }
  .close { opacity: 0; transform: rotate(-90deg); }
  
  #typefaceing-panel {
    position: fixed; top: 70px; right: 0px; width: 220px; 
    background: var(--bg-sidebar, #1a1a1a) !important; 
    opacity: 0; border: 4px solid var(--color-6, #444); border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5); z-index: 10000;
    transition: opacity 0.3s ease, transform 0.3s ease; pointer-events: none;
    transform: translateY(-10px);
  }

  #typefaceing-panel.show { opacity: 1 !important; transform: translateY(0); pointer-events: auto; }
  .typefaceing-solid-wrapper { padding: 15px; width: 100%; box-sizing: border-box; }

  .text-font-label {
    color: var(--text-main, #fff); font-size: 0.7rem; margin-bottom: 8px; 
    opacity: 0.7; text-transform: uppercase; letter-spacing: 1px;
  }

  .typefaceing-dropdown {
    background: var(--color-7, #333); color: var(--text-main, #fff);
    border: 2px solid var(--color-6, #555); border-radius: 8px;
    padding: 10px; cursor: pointer; font-size: 0.9rem;
    outline: none; width: 100%; transition: border-color 0.2s;
  }
</style>

<script type="module">
  const toggle = document.getElementById("typefaceing-toggle");
  const panel = document.getElementById("typefaceing-panel");
  const fontSelect = document.getElementById("text-font-select");
  let isOpen = false;

  // 1. Create a dedicated style element for the global font override
  const fontOverrideStyle = document.createElement('style');
  fontOverrideStyle.id = "global-font-override";
  document.head.appendChild(fontOverrideStyle);

  // 2. Function to update the style block
  const updateGlobalFont = (fontFamily) => {
    // If 'inherit', we clear the override to let the site default take over
    if (fontFamily === "inherit") {
      fontOverrideStyle.innerHTML = "";
    } else {
      // The * selector with !important ensures every single tag is forced to change
      fontOverrideStyle.innerHTML = `
        *, *::before, *::after {
          font-family: ${fontFamily} !important;
        }
      `;
    }
  };

  // 3. Initial Font Loading
  const savedFont = localStorage.getItem("text-font-preference") || "inherit";
  updateGlobalFont(savedFont);
  fontSelect.value = savedFont;

  // 4. Font Change Listener
  fontSelect.addEventListener("change", (e) => {
    const newFont = e.target.value;
    updateGlobalFont(newFont);
    localStorage.setItem("text-font-preference", newFont);
  });

  // 5. Toggle Panel Logic
  toggle.addEventListener("click", () => {
    isOpen = !isOpen;
    if (isOpen) {
      panel.hidden = false;
      setTimeout(() => panel.classList.add("show"), 10);
      toggle.querySelector('.typeface').style.opacity = '0';
      toggle.querySelector('.close').style.opacity = '1';
    } else {
      panel.classList.remove("show");
      setTimeout(() => { if(!isOpen) panel.hidden = true; }, 300);
      toggle.querySelector('.typeface').style.opacity = '1';
      toggle.querySelector('.close').style.opacity = '0';
    }
  });
</script>
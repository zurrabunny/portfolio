---
import "../styles/global.css";
import DarkModeToggle from '../components/DarkModeToggle.astro';

const fontUrl = "https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&display=swap";

const descriptions = {
  "solitude composition": "limited palette digital illustration. golden retriever. cel-shading.",
  "National Bookstore": "limited palette digital illustration. golden retriever. cel-shading.",
  "Abstract Face": "limited palette digital illustration. golden retriever. cel-shading.",
  "beastars minimalist book cover": "limited palette digital illustration. golden retriever. cel-shading.",
  "design in daily life": "limited palette digital illustration. golden retriever. cel-shading.",
  "iron lung minimalist poster": "limited palette digital illustration. golden retriever. cel-shading.",
  "Minecraft Magazine Cover": "limited palette digital illustration. golden retriever. cel-shading.",
  "grow together": "limited palette digital illustration. golden retriever. cel-shading.",
};

const allImages = await Astro.glob('/public/graphicdesign/*.{jpg,jpeg,png,webp,gif}');
const primaryImages = allImages.filter(img => !img.default.src.includes('_process'));
const serializedImages = allImages.map(img => img.default.src);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>zurra | work</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&display=swap">
  </head>
  
  <body>    
    <aside id="left-sidebar">
      <div>
        <header>
          <h1>zurrabunny</h1>
          <div class="category-tag">graphic design</div>
        </header>

        <nav>
          <ul class="nav-links">
            <li id="about-toggle">about</li>
          </ul>
        </nav>

        <div id="about-content">
          <div class="inner-content">
            <p>Hello, I'm Zurra! I provide painterly renders for characters and backgrounds. My skill set includes rough, clean, and 2D rigged animation. I build 3D assets in Blender and Blockbench while composing original audio in FL Studio. My technical range covers website development with Astro and video editing.</p>
			<p>I mainly use Adobe Illustrator, Adobe Photoshop, and Clip Studio Paint for drawing and designing</p>
            
            <div class="software-shelf">
              <img src="./graphicdesign/logo/illustrator.png" alt="Adobe Illustrator" title="Adobe Illustrator" />
              <img src="./graphicdesign/logo/photoshop.png" alt="Adobe Photoshop" title="Adobe Photoshop" />
              <img src="./graphicdesign/logo/csp.png" alt="Clip Studio Paint" title="Clip Studio Paint" />
            </div>
          </div>
        </div>
      </div>

      <div>
        <a href="/portfolio/" class="back-link">← main website</a>
        <footer class="sidebar-footer">:3</footer>
      </div>
    </aside>

    <div id="modal-overlay">
      <div id="modal-content">
        <span id="close-trigger">&times;</span>
        <div id="modal-grid">
          <div id="modal-left">
            <img id="modal-img-display" src="" alt="view" />
          </div>
          <div id="modal-sidebar">
            <h2 id="modal-title"></h2>
            <p id="modal-description"></p>
            <div id="process-section">
              <h4 id="process-header">behind the scenes</h4>
              <div id="process-list"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <main id="main-content">
      <section class="gallery-masonry">
        {primaryImages.map((img) => {
          const fileName = img.default.src.split('/').pop().split('.')[0];
          const desc = descriptions[fileName] || "visual composition study.";
          return (
            <div class="gallery-item" data-fullsrc={img.default.src} data-base={fileName} data-desc={desc}>
              <img src={img.default.src} alt={fileName} loading="lazy" />
              <div class="item-label">{fileName.replace(/-/g, ' ')}</div>
            </div>
          )
        })}
      </section>
    </main>

    <script is:inline define:vars={{ serializedImages }}>
      // JAVASCRIPT MANAGED STYLES
      const injectStyles = () => {
        const style = document.createElement('style');
        style.textContent = `
          * { box-sizing: border-box; }
          body { 
            margin: 0; background: #fbfbfb; color: #111; 
            font-family: 'Fredoka', sans-serif; display: flex; overflow-x: hidden;
          }
          h1, h2, h3, h4 { font-weight: 700; text-transform: lowercase; margin: 0; }
          h1 { font-size: 2.2rem; letter-spacing: -0.04em; color: #000; }
          h2 { font-size: 2.8rem; line-height: 1; margin-bottom: 1rem; }
          h4 { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: #aaa; }
          p { line-height: 1.6; line-height: 1.4; color: #444; font-size: 1.1rem; }

          #left-sidebar {
            width: 320px; height: 100vh; position: fixed; left: 0; top: 0;
            padding: 4rem 2.5rem; border-right: 4px solid #000;
            display: flex; flex-direction: column; justify-content: space-between;
            z-index: 10; background: #fff; box-shadow: 10px 0 0 rgba(0,0,0,0.02);
          }
          .category-tag {
            background: #000; color: #fff; display: inline-block; 
            padding: 4px 12px; font-size: 0.8rem; margin-top: 0.5rem; 
            font-weight: 600; text-transform: uppercase;
          }
          .nav-links { list-style: none; padding: 0; margin-top: 3rem; }
          .nav-links li { 
            margin-bottom: 1rem; font-size: 1.4rem; color: #000; 
            font-weight: 600; cursor: pointer; display: inline-block; position: relative;
          }
          .nav-links li::after {
            content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 8px;
            background: #c79cff; z-index: -1; transition: width 0.3s ease;
          }
          .nav-links li:hover::after { width: 100%; }

          /* UPDATED TRANSITION LOGIC */
          #about-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 1rem; color: #333;
          }
          #about-content .inner-content {
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.4s ease, transform 0.4s ease;
            background: #f9f9f9; border-radius: 12px;
            padding: 1.5rem; margin-top: 0.3rem; border: 2px dashed #ddd;
          }
          #about-content.is-visible { 
            max-height: 1000px; /* Large enough value to accommodate content */
          }
          #about-content.is-visible .inner-content {
            opacity: 1;
            transform: translateY(0);
          }

          /* Software Shelf Styling */
          .software-shelf {
            display: flex;
            gap: 12px;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #eee;
          }
          .software-shelf img {
            width: 32px;
            height: 32px;
            object-fit: contain;
            filter: grayscale(100%);
            transition: all 0.3s ease;
            cursor: help;
          }
          .software-shelf img:hover {
            filter: grayscale(0%);
            transform: translateY(-3px);
          }

          .back-link {
            display: inline-block; text-decoration: none; color: #000;
            font-size: 0.9rem; font-weight: 600; padding: 12px 24px;
            background: #fff; border: 3px solid #000; border-radius: 0;
            transform: rotate(-2deg); transition: all 0.2s;
          }
          .back-link:hover { transform: rotate(0deg) scale(1.05); background: #000; color: #fff; }
          .sidebar-footer { font-size: 0.9rem; color: #000; font-weight: 700; margin-top: 2rem; opacity: 0.2; }

          #main-content { margin-left: 320px; width: calc(100% - 320px); padding: 5rem; min-height: 100vh; }
          .gallery-masonry { column-count: 3; column-gap: 3rem; }
          .gallery-item {
            display: inline-block; width: 100%; margin-bottom: 3.5rem;
            background: #fff; border: 3px solid #000; padding: 10px;
            cursor: pointer; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 8px 8px 0 #000;
          }
          .gallery-item:nth-child(even) { transform: rotate(1.5deg); }
          .gallery-item:nth-child(odd) { transform: rotate(-1.5deg); }
          .gallery-item img { width: 100%; height: auto; display: block; filter: grayscale(10%); transition: filter 0.3s; }
          .gallery-item:hover { transform: rotate(0deg) translateY(-10px); box-shadow: 15px 15px 0 #c79cff; }
          .gallery-item:hover img { filter: grayscale(0%); }
          .item-label { margin-top: 10px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #aaa; }

          #modal-description { border-left: 4px solid #c79cff; padding-left: 1rem; }
          #process-section { margin-top: 3rem; }

          @media (max-width: 1400px) { .gallery-masonry { column-count: 2; } }
          @media (max-width: 1000px) {
            #left-sidebar { width: 100%; height: auto; position: relative; border-right: none; border-bottom: 4px solid #000; padding: 3rem; }
            #main-content { margin-left: 0; width: 100%; padding: 3rem; }
            body { flex-direction: column; }
            .gallery-masonry { column-count: 1; }
          }
        `;
        document.head.appendChild(style);
      };

      injectStyles();

      const aboutToggle = document.getElementById('about-toggle');
      const aboutContent = document.getElementById('about-content');
      aboutToggle.addEventListener('click', () => aboutContent.classList.toggle('is-visible'));

      const modal = document.getElementById('modal-overlay');
      const modalContent = document.getElementById('modal-content');
      const modalGrid = document.getElementById('modal-grid');
      const modalLeft = document.getElementById('modal-left');
      const modalImg = document.getElementById('modal-img-display');
      const modalSidebar = document.getElementById('modal-sidebar');
      const modalTitle = document.getElementById('modal-title');
      const modalDesc = document.getElementById('modal-description');
      const processList = document.getElementById('process-list');
      const closeTrigger = document.getElementById('close-trigger');

      const styleModal = () => {
        const isMobile = window.innerWidth <= 1000;
        Object.assign(modal.style, {
          position: 'fixed', inset: '0', backgroundColor: 'rgba(255,255,255,0.98)',
          display: 'none', justifyContent: 'center', alignItems: 'center',
          zIndex: '9999', padding: isMobile ? '0' : '40px', opacity: '0', transition: 'opacity 0.4s ease'
        });
        Object.assign(modalContent.style, {
          backgroundColor: '#ffffff', width: isMobile ? '100%' : '85%', height: isMobile ? '100vh' : '90vh', 
          border: '4px solid #000', borderRadius: '0', display: 'flex', overflow: 'hidden', position: 'relative',
          boxShadow: '30px 30px 0 rgba(0,0,0,0.1)', transform: 'translateY(20px)', 
          transition: 'transform 0.5s cubic-bezier(0.23, 1, 0.32, 1)'
        });
        Object.assign(modalGrid.style, { display: 'grid', width: '100%', height: '100%', gridTemplateColumns: isMobile ? '1fr' : '1fr 500px' });
        Object.assign(modalLeft.style, { padding: '3rem', display: 'flex', alignItems: 'center', justifyContent: 'center', backgroundColor: '#f0f0f0', overflow: 'hidden' });
        Object.assign(modalImg.style, { maxWidth: '100%', maxHeight: '100%', objectFit: 'contain', border: '3px solid #000' });
        Object.assign(modalSidebar.style, { backgroundColor: '#fff', padding: '5rem 4rem', overflowY: 'auto', borderLeft: isMobile ? 'none' : '4px solid #000', display: 'flex', flexDirection: 'column' });
        Object.assign(closeTrigger.style, { position: 'absolute', top: '0rem', right: '2.5rem', fontSize: '3.5rem', color: '#000', zIndex: '100', cursor: 'pointer', fontWeight: '700' });
      };

      styleModal();
      window.addEventListener('resize', styleModal);

      document.querySelectorAll('.gallery-item').forEach(item => {
        item.addEventListener('click', () => {
          const baseName = item.getAttribute('data-base');
          modalImg.src = item.getAttribute('data-fullsrc');
          modalTitle.textContent = baseName.replace(/-/g, ' ');
          modalDesc.textContent = item.getAttribute('data-desc');
          modalSidebar.scrollTop = 0;
          processList.innerHTML = '';
          const related = serializedImages.filter(src => src.split('/').pop().startsWith(baseName + '_process')).sort();

          if (related.length > 0) {
            document.getElementById('process-section').style.display = 'block';
            related.forEach((src) => {
              const container = document.createElement('div');
              container.style.marginBottom = '2.5rem';
              const img = document.createElement('img');
              img.src = src;
              Object.assign(img.style, { width: '100%', height: 'auto', display: 'block', border: '3px solid #000', transition: 'all 0.3s', cursor: 'pointer' });
              img.onclick = () => { modalImg.src = src; };
              img.onmouseover = () => { img.style.transform = 'translate(-5px, -5px)'; img.style.boxShadow = '5px 5px 0 #c79cff'; };
              img.onmouseout = () => { img.style.transform = 'none'; img.style.boxShadow = 'none'; };
              container.appendChild(img);
              processList.appendChild(container);
            });
          } else {
            document.getElementById('process-section').style.display = 'none';
          }

          modal.style.display = 'flex';
          void modal.offsetWidth;
          modal.style.opacity = '1';
          modalContent.style.transform = 'translateY(0)';
          document.body.style.overflow = 'hidden';
        });
      });

      const hideModal = () => {
        modal.style.opacity = '0';
        modalContent.style.transform = 'translateY(20px)';
        setTimeout(() => { modal.style.display = 'none'; document.body.style.overflow = 'auto'; }, 400);
      };

      closeTrigger.onclick = hideModal;
      window.onclick = (e) => { if (e.target == modal) hideModal(); };
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideModal(); });
    </script>
  </body>
</html>
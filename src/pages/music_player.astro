---
import "../styles/global.css";
import Music from "../components/pages/work_modules/Music.astro";
import DarkModeToggle from '../components/DarkModeToggle.astro';
import MusicControls from '../components/MusicControls.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>zurra's site of fun and whimsy</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TJDSJZMJTR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-TJDSJZMJTR');

      (function() {
        const savedTheme = localStorage.getItem('darkMode');
        if (savedTheme === 'enabled' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark-mode');
        }
      })();
    </script>
  </head>

  <body>
    <div class="bg-grid-root">
      <canvas id="bg-grid-canvas" aria-hidden="true"></canvas>
    </div>

	<MusicControls />

    <div id="page-wrapper">
      <nav class="ui-layer">
        <div class="top-controls">
          <DarkModeToggle />
        </div>
      </nav>

      <aside class="music-container">
        <div class="glass-morph">
          <Music />
        </div>
      </aside>

      <main id="main-content" class="content">
        <slot /> 
      </main>
    </div>

    <style>

      #page-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        z-index: 1;
      }

      .bg-grid-root {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }

      #bg-grid-canvas {
        width: 100%;
        height: 100%;
        display: block;
      }

      /* Centered Container Styles */
      .music-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 50%;
        z-index: 100;
        color: var(--text-dark);
      }

      .glass-morph {
        background: var(--container);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 30px;
        padding: 24px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px); /* Optional: adds to the 'glass' feel */
      }

      /* UI Controls */
      .ui-layer {
        display: flex;
        justify-content: flex-end; /* Moves toggle to the right */
        padding: 1.5rem;
        pointer-events: none;
      }

      .ui-layer > * {
        pointer-events: auto;
      }

      /* Mobile Adjustments */
      @media (max-width: 900px) {
        .music-container {
          width: 85%;
        }
        .glass-morph {
          padding: 16px;
          border-radius: 20px;
        }
      }
    </style>

    <script>
      /**
       * Background Canvas Animation
       */
      const initCanvas = () => {
        const canvas = document.getElementById("bg-grid-canvas");
        if (!canvas) return;
        const ctx = canvas.getContext("2d", { alpha: false });
        if (!ctx) return;

        let width, height, dpr;
        let cellSize = 64;
        let offsetX = 0, offsetY = 0;
        const scrollSpeed = 0.2;

        const getColors = () => {
          const styles = getComputedStyle(document.documentElement);
          return {
            a: styles.getPropertyValue('--bg-grid-color-a').trim() || '#000',
            b: styles.getPropertyValue('--bg-grid-color-b').trim() || '#111'
          };
        };

        function resize() {
          dpr = window.devicePixelRatio || 1;
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          ctx.scale(dpr, dpr);
          cellSize = width <= 900 ? 40 : 64;
        }

        function draw() {
          const colors = getColors();
          ctx.fillStyle = colors.a;
          ctx.fillRect(0, 0, width, height);

          // Grid logic for desktop
          if (width > 900) {
            const cols = Math.ceil(width / cellSize) + 2;
            const rows = Math.ceil(height / cellSize) + 2;
            ctx.fillStyle = colors.b;

            for (let y = -1; y < rows; y++) {
              for (let x = -1; x < cols; x++) {
                if ((x + y) % 2 === 0) {
                  ctx.fillRect(
                    Math.floor(x * cellSize + offsetX),
                    Math.floor(y * cellSize + offsetY),
                    cellSize,
                    cellSize
                  );
                }
              }
            }
            offsetX = (offsetX - scrollSpeed) % cellSize;
            offsetY = (offsetY - scrollSpeed) % cellSize;
          }

          requestAnimationFrame(draw);
        }

        window.addEventListener("resize", resize, { passive: true });
        resize();
        draw();
      };

      // Support for Astro View Transitions
      document.addEventListener('astro:page-load', initCanvas);
      // Fallback for initial load
      if (document.readyState === 'complete') {
        initCanvas();
      } else {
        window.addEventListener('load', initCanvas);
      }
    </script>
  </body>
</html>
---
import "../styles/global.css";
import DarkModeToggle from '../components/DarkModeToggle.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>zurra's online wallpaper</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
 
  </head>
	<DarkModeToggle />
  <body>
    <div class="bg-grid-root">
      <canvas id="bg-grid-canvas" aria-hidden="true"></canvas>
    </div>
    <style>

      #page-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        z-index: 1;
      }

      .bg-grid-root {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }

      #bg-grid-canvas {
        width: 100%;
        height: 100%;
        display: block;
      }
    </style>

    <script>
      /**
       * Background Canvas Animation
       */
      const initCanvas = () => {
        const canvas = document.getElementById("bg-grid-canvas");
        if (!canvas) return;
        const ctx = canvas.getContext("2d", { alpha: false });
        if (!ctx) return;

        let width, height, dpr;
        let cellSize = 64;
        let offsetX = 0, offsetY = 0;
        const scrollSpeed = 0.2;

        const getColors = () => {
          const styles = getComputedStyle(document.documentElement);
          return {
            a: styles.getPropertyValue('--bg-grid-color-a').trim() || '#000',
            b: styles.getPropertyValue('--bg-grid-color-b').trim() || '#111'
          };
        };

        function resize() {
          dpr = window.devicePixelRatio || 1;
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          ctx.scale(dpr, dpr);
          cellSize = width <= 900 ? 40 : 64;
        }

        function draw() {
          const colors = getColors();
          ctx.fillStyle = colors.a;
          ctx.fillRect(0, 0, width, height);

          // Grid logic for desktop
          if (width > 900) {
            const cols = Math.ceil(width / cellSize) + 2;
            const rows = Math.ceil(height / cellSize) + 2;
            ctx.fillStyle = colors.b;

            for (let y = -1; y < rows; y++) {
              for (let x = -1; x < cols; x++) {
                if ((x + y) % 2 === 0) {
                  ctx.fillRect(
                    Math.floor(x * cellSize + offsetX),
                    Math.floor(y * cellSize + offsetY),
                    cellSize,
                    cellSize
                  );
                }
              }
            }
            offsetX = (offsetX - scrollSpeed) % cellSize;
            offsetY = (offsetY - scrollSpeed) % cellSize;
          }

          requestAnimationFrame(draw);
        }

        window.addEventListener("resize", resize, { passive: true });
        resize();
        draw();
      };

      // Support for Astro View Transitions
      document.addEventListener('astro:page-load', initCanvas);
      // Fallback for initial load
      if (document.readyState === 'complete') {
        initCanvas();
      } else {
        window.addEventListener('load', initCanvas);
      }
    </script>
  </body>
</html>
---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Whimsy Not Found</title>
  </head>

  <body>
    <div id="page-wrapper">
      <main class="content redirect-container">
        <div class="bubby-wrapper">
          <img src="/bubby/bubby.gif" alt="Bubby" class="bubby-dark" />
        </div>

        <div class="redirect-card">
          <h1>404</h1>
		  <div id="status-msg">PAGE NOT FOUND</div>
          <p>Looks like you've wandered into the void!</p>
          <a href="/portfolio">Click here</a> to go back home! >:]</p>
        </div>
      </main>
    </div>

    <div class="bg-grid-root">
      <canvas id="bg-grid-canvas" aria-hidden="true"></canvas>
    </div>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    background-color: var(--bg-grid-color-a);
    color: var(--text-main);
    overflow: hidden; 
  }

  #page-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    min-height: 100vh;
  }

  .redirect-container {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    z-index: 10;
  }

  /* BUBBY STYLING */
  .bubby-wrapper {
    margin-bottom: 0px; 
    z-index: 11;
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.5));
    animation: float 3s ease-in-out infinite;
  }

  .bubby-dark {
    width: 200px;
    height: auto;
    /* Pure black silhouette effect */
    filter: brightness(0); 
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  .redirect-card {
    background: var(--bg-sidebar);
    border: 3px solid var(--border-sidebar);
    padding: 3rem;
    border-radius: 20px;
    box-shadow: 10px 10px 0px var(--color-3);
    max-width: 400px;
    position: relative;
  }

  h1 {
    font-size: 4rem;
    margin: 0;
    color: var(--color-3);
  }

  #status-msg {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--text-main);
    margin: 1rem 0;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .small { font-size: 1rem; margin-top: 20px; line-height: 1.5; }
  a { color: var(--color-3); font-weight: bold; text-decoration: underline; }

  .bg-grid-root {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: -10;
    pointer-events: none;
  }
  #bg-grid-canvas { width: 100%; height: 100%; display: block; }

  @media (max-width: 900px) {
    #page-wrapper { flex-direction: column; }
    .redirect-card { margin-top: 20px; padding: 2rem; }
  }
</style>

<script type="module">
  /* Grid logic stays exactly as you had it */
  (() => {
    const canvas = document.getElementById("bg-grid-canvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    ctx.imageSmoothingEnabled = false;

    let width, height, dpr;
    let cellSize = 64;
    const scrollSpeed = 0.2;
    const diagonal = true;

    function parseColor(color) {
      if (!color) return [0,0,0,1];
      color = color.trim();
      if (color.startsWith('#')) return [parseInt(color.slice(1,3),16),parseInt(color.slice(3,5),16),parseInt(color.slice(5,7),16),1];
      else if (color.startsWith('rgba')) return color.match(/\d+\.?\d*/g).map(Number);
      else if (color.startsWith('rgb')) return [...color.match(/\d+/g).map(Number),1];
      return [0,0,0,1];
    }
    function lerpArr(a,b,t){return a.map((v,i)=>v+(b[i]-v)*t);}
    function rgbaStr(arr){return `rgba(${Math.round(arr[0])},${Math.round(arr[1])},${Math.round(arr[2])},${arr[3]})`; }

    let rootStyles = getComputedStyle(document.documentElement);
    let targetA = parseColor(rootStyles.getPropertyValue('--bg-grid-color-a') || '#ffffff');
    let targetB = parseColor(rootStyles.getPropertyValue('--bg-grid-color-b') || '#eeeeee');
    let currentA = [...targetA], currentB=[...targetB];
    const transitionSpeed=0.08;
    let offsetX=0, offsetY=0;

    function resize() {
      dpr = Math.max(1, window.devicePixelRatio || 1);
      width = window.innerWidth;
      height = window.innerHeight;
      cellSize = width<=900?40:64;
      canvas.width = width*dpr;
      canvas.height = height*dpr;
      ctx.setTransform(dpr,0,0,dpr,0,0);
    }

    function draw() {
      currentA=lerpArr(currentA,targetA,transitionSpeed);
      currentB=lerpArr(currentB,targetB,transitionSpeed);
      ctx.clearRect(0,0,width,height);

      if(width>900){
        const cols=Math.ceil(width/cellSize)+2;
        const rows=Math.ceil(height/cellSize)+2;
        for(let y=-1;y<rows;y++){
          for(let x=-1;x<cols;x++){
            ctx.fillStyle=(x+y)%2===0?rgbaStr(currentA):rgbaStr(currentB);
            ctx.fillRect(Math.round(x*cellSize+offsetX),Math.round(y*cellSize+offsetY),cellSize,cellSize);
          }
        }
        if(diagonal){offsetX-=scrollSpeed;offsetY-=scrollSpeed;}
        else offsetX-=scrollSpeed;
        if(offsetX<=-cellSize) offsetX+=cellSize;
        if(offsetY<=-cellSize) offsetY+=cellSize;
      }else{
        ctx.fillStyle=rgbaStr(currentA);
        ctx.fillRect(0,0,width,height);
      }
      requestAnimationFrame(draw);
    }

    resize();
    draw();
    window.addEventListener("resize", resize,{passive:true});
  })();
</script>
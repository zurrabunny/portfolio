---
import "../styles/global.css";

import DarkModeToggle from '../components/DarkModeToggle.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Whimsy Not Found</title>
  </head>

  <body>
    <div id="page-wrapper">
	<DarkModeToggle />
      <main class="content redirect-container">
        <div class="bubby-wrapper">
          <img src="./bubby/bubby.gif" alt="Bubby" class="bubby-dark" />
        </div>

        <div class="redirect-card">
          <h1>404</h1>
		  <div id="status-msg">PAGE NOT FOUND</div>
          <p>Looks like you've wandered into the void!</p>
          <a href="/portfolio/">Click here</a> to go back home! >:]</p>
        </div>
      </main>
    </div>

    <div class="bg-grid-root">
      <canvas id="bg-grid-canvas" aria-hidden="true"></canvas>
    </div>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    background-color: var(--bg-grid-color-a);
    color: var(--text-main);
    overflow: hidden; 
  }

  #page-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    min-height: 100vh;
  }

  .redirect-container {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    z-index: 10;
  }

  /* BUBBY STYLING */
  .bubby-wrapper {
    margin-bottom: 0px; 
    z-index: 11;
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.5));
    animation: float 3s ease-in-out infinite;
  }

  .bubby-dark {
    width: 200px;
    height: auto;
    /* Pure black silhouette effect */
    filter: brightness(0); 
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  .redirect-card {
    background: var(--bg-sidebar);
    border: 3px solid var(--border-sidebar);
    padding: 3rem;
    border-radius: 20px;
    box-shadow: 10px 10px 0px var(--color-3);
    max-width: 400px;
    position: relative;
  }

  h1 {
    font-size: 4rem;
    margin: 0;
    color: var(--color-3);
  }

  #status-msg {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--text-main);
    margin: 1rem 0;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .small { font-size: 1rem; margin-top: 20px; line-height: 1.5; }
  a { color: var(--color-3); font-weight: bold; text-decoration: underline; }

  .bg-grid-root {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: -10;
    pointer-events: none;
  }
  #bg-grid-canvas { width: 100%; height: 100%; display: block; }

  @media (max-width: 900px) {
    #page-wrapper { flex-direction: column; }
    .redirect-card { margin-top: 20px; padding: 2rem; }
  }
</style>